+      # 2026-09-20: identification probe (AccordIdProbe, 0 = off = byte-for-byte the path above).  Added at the
+      # same node as the dither and under the same three interlocks -- engaged, hands off the wheel, and not
+      # while the Honda rate limiter is active, which would freeze the integrator and the observer.  Everything
+      # else is left to the OFFLINE window selection: every in-code gate is a multiplication in time, hence a
+      # convolution in frequency, which smears the probe off its bins and destroys the free noise floor that the
+      # inter-tone bins provide.  So there is no demand gate and no angle gate here, on purpose.
+      probe_on = (active and not steer_limited_by_safety and not CS.steeringPressed)
+      ramp_step = self.dt / max(HONDA_ACCORD_ID_PROBE_RAMP_S, self.dt)
+      self.accord_probe_ramp = float(np.clip(self.accord_probe_ramp + (ramp_step if probe_on else -ramp_step),
+                                             0.0, 1.0))
+      if self.accord_probe_ramp > 0.0:
+        self.accord_probe_frame += 1
+        probe = self.accord_probe_ramp * get_honda_accord_id_probe(
+          float(getattr(starpilot_toggles, "accord_id_probe", 0.0)),
+          self.accord_probe_frame, self.dt, CS.vEgo)
+      else:
+        self.accord_probe_frame = 0
+        probe = 0.0
