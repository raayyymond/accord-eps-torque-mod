          <access>read-only</access>
          <resetValue>0x00</resetValue>
          <fields>
            <field>
              <name>DTS0TON3</name>
              <description>TI hold buffer 3 occupied</description>
              <bitRange>[3:3]</bitRange>
            </field>
            <field>
              <name>DTS0TON2</name>
              <description>TI hold buffer 2 occupied</description>
              <bitRange>[2:2]</bitRange>
            </field>
            <field>
              <name>DTS0TON1</name>
              <description>TI hold buffer 1 occupied</description>
              <bitRange>[1:1]</bitRange>
            </field>
            <field>
              <name>DTS0TON0</name>
              <description>TI hold buffer 0 occupied</description>
              <bitRange>[0:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>DTS0HC</name>
          <description>DTS TI Hold Channel Number Register (32-bit; bytes 0..3 = HC0..HC3)</description>
          <addressOffset>0x20</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DTS0HC3_CH6_0</name>
              <description>Hold buffer 3 channel number [6:0] (bits [30:24])</description>
              <bitRange>[30:24]</bitRange>
            </field>
            <field>
              <name>DTS0HC2_CH6_0</name>
              <description>Hold buffer 2 channel number [6:0] (bits [22:16])</description>
              <bitRange>[22:16]</bitRange>
            </field>
            <field>
              <name>DTS0HC1_CH6_0</name>
              <description>Hold buffer 1 channel number [6:0] (bits [14:8])</description>
              <bitRange>[14:8]</bitRange>
            </field>
            <field>
              <name>DTS0HC0_CH6_0</name>
              <description>Hold buffer 0 channel number [6:0] (bits [6:0])</description>
              <bitRange>[6:0]</bitRange>
            </field>
          </fields>
        </register>
      </registers>
