    <peripheral>
      <name>DTS</name>
      <description>Data Transfer Service Control Registers (CPU-accessible Group A)</description>
      <baseAddress>0xFFFF7C00</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x24</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>DTS0TSR</name>
          <description>DTS Transfer Status Register</description>
          <addressOffset>0x00</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <resetValue>0x00</resetValue>
          <fields>
            <field>
              <name>DTS0STPE</name>
              <description>DTS stopped by error response</description>
              <bitRange>[1:1]</bitRange>
            </field>
            <field>
              <name>DTS0STPU</name>
              <description>DTS stopped by user request</description>
              <bitRange>[0:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>DTS0TRC</name>
          <description>DTS Transfer Request Control Register</description>
          <addressOffset>0x04</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <fields>
            <field>
              <name>DTS0UST</name>
              <description>DTS user stop trigger; write 1 to suspend all DTS</description>
              <bitRange>[7:7]</bitRange>
            </field>
            <field>
              <name>DTS0ECL</name>
              <description>DTS0STPE clearing trigger; write 1 to clear error stop</description>
              <bitRange>[1:1]</bitRange>
            </field>
            <field>
              <name>DTS0UCL</name>
              <description>DTS0STPU clearing trigger; write 1 to clear user stop</description>
              <bitRange>[0:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>DTS0ICR</name>
          <description>DTS Initialization Control Register (16-bit; lower byte=DTS0ICH, upper byte=DTS0ITR)</description>
          <addressOffset>0x08</addressOffset>
          <size>16</size>
          <access>read-write</access>
          <resetValue>0x0000</resetValue>
          <fields>
            <field>
              <name>DTS0ICS</name>
              <description>DTS initialization channel select status</description>
              <bitRange>[10:10]</bitRange>
            </field>
            <field>
              <name>DTS0HIT</name>
              <description>DTS TI hold init trigger; write 1 to trigger</description>
              <bitRange>[9:9]</bitRange>
            </field>
            <field>
              <name>DTS0TIT</name>
              <description>DTS TI init trigger; write 1 to trigger</description>
              <bitRange>[8:8]</bitRange>
            </field>
            <field>
              <name>DTS0ICH6_0</name>
              <description>DTS initialization channel number [6:0]</description>
              <bitRange>[6:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>DTS0BTR</name>
          <description>DTS Base Table Register — start address of DTS channel table in on-chip RAM</description>
          <addressOffset>0x0C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DTS0BTR28_1</name>
              <description>Table base address bits [28:1]; bits 31:29 and 0 are fixed 0</description>
              <bitRange>[28:1]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>DTS0BVR</name>
          <description>DTS Base Vector Register — start address of DTS vector table in on-chip RAM</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DTS0BVR28_2</name>
              <description>Vector base address bits [28:2]; bits 31:29, 1, 0 fixed 0</description>
              <bitRange>[28:2]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>DTS0ACR</name>
          <description>DTS Active Channel Register</description>
          <addressOffset>0x14</addressOffset>
          <size>16</size>
          <access>read-only</access>
          <resetValue>0x0000</resetValue>
