          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DCRA1CIN</name>
              <description>Input data for CRC calculation (valid width controlled by DCRA1CTL.DCRA1ISZ)</description>
              <bitRange>[31:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>DCRA1COUT</name>
          <description>CRC Data Register — instance 1; stores CRC result; read returns value XOR'd with poly constant</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xFFFFFFFF</resetValue>
          <fields>
            <field>
              <name>DCRA1COUT</name>
              <description>CRC result; initialize with starting value before first write to DCRA1CIN</description>
              <bitRange>[31:0]</bitRange>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>POFLVI</name>
      <description>Power-On Flag and LVI Status registers (base cluster 0xFFFFFC00)</description>
      <baseAddress>0xFFFFFC00</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x11</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>POF</name>
          <description>Power-on Flag Register — bit 0 set when EVDD falls below POF detection voltage; read-only 8-bit</description>
          <addressOffset>0x0</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <resetValue>0x01</resetValue>
          <fields>
            <field>
              <name>POF</name>
              <description>Power-on flag: 0=EVDD above detection voltage, 1=EVDD below detection voltage</description>
              <bitRange>[0:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>POFC</name>
          <description>Power-on Flag Clear Register — write 1 to bit 0 to clear POF.POF; reads as 00H</description>
          <addressOffset>0x4</addressOffset>
          <size>8</size>
          <access>write-only</access>
          <resetValue>0x00</resetValue>
          <fields>
            <field>
              <name>POFC</name>
              <description>POF clear: writing 1 clears POF.POF to 0</description>
              <bitRange>[0:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>POFS</name>
          <description>Power-on Flag Set Register — write 1 to bit 0 to set POF.POF (test use); reads as 00H</description>
          <addressOffset>0x8</addressOffset>
          <size>8</size>
          <access>write-only</access>
          <resetValue>0x00</resetValue>
          <fields>
            <field>
              <name>POFS</name>
              <description>POF set: writing 1 sets POF.POF to 1</description>
              <bitRange>[0:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>LVISF</name>
          <description>LVI Status Flag Register — bit 0 indicates current LVI detection state; read-only 8-bit</description>
          <addressOffset>0x10</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <resetValue>0x00</resetValue>
          <fields>
            <field>
              <name>LVISF</name>
              <description>LVI detection flag: 0=EVDD not low (or LVI not operating), 1=EVDD low</description>
              <bitRange>[0:0]</bitRange>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>UARTH_IC0</name>
      <description>LIN Communications Slave Operation Baud-Rate Detection Registers (IC0REG0/IC0REG1)</description>
      <baseAddress>0xFFFFFE00</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x8</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>IC0REG0</name>
          <description>LIN Baud-Rate Detection Register 0 — TAUA0 channel input selection</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>IC0REG1</name>
          <description>LIN Baud-Rate Detection Register 1 — TAUA1 channel input selection</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
        </register>
      </registers>
    </peripheral>
  </peripherals>
</device>