              <description>BF bit length during transmission [2]</description>
              <bitRange>[14:14]</bitRange>
            </field>
            <field>
              <name>URTHnBLG1</name>
              <description>BF bit length during transmission [1]</description>
              <bitRange>[13:13]</bitRange>
            </field>
            <field>
              <name>URTHnBLG0</name>
              <description>BF bit length during transmission [0]</description>
              <bitRange>[12:12]</bitRange>
            </field>
            <field>
              <name>URTHnCLG</name>
              <description>Bit length of transmit/receive data (0=7 bits, 1=8/9 bits)</description>
              <bitRange>[8:8]</bitRange>
            </field>
            <field>
              <name>URTHnSLP1</name>
              <description>Parity bit selection [1]</description>
              <bitRange>[7:7]</bitRange>
            </field>
            <field>
              <name>URTHnSLP0</name>
              <description>Parity bit selection [0]</description>
              <bitRange>[6:6]</bitRange>
            </field>
            <field>
              <name>URTHnTDL</name>
              <description>Transmit data level control (0=normal, 1=inverted)</description>
              <bitRange>[5:5]</bitRange>
            </field>
            <field>
              <name>URTHnRDL</name>
              <description>Received data level control (0=normal, 1=inverted)</description>
              <bitRange>[4:4]</bitRange>
            </field>
            <field>
              <name>URTHnLPM</name>
              <description>Loop back mode control (0=disabled, 1=enabled)</description>
              <bitRange>[3:3]</bitRange>
            </field>
            <field>
              <name>URTHnSLG</name>
              <description>Stop bit count for transmit (0=1 bit, 1=2 bits)</description>
              <bitRange>[2:2]</bitRange>
            </field>
            <field>
              <name>URTHnSLD</name>
              <description>Transfer direction (0=MSB-first, 1=LSB-first)</description>
              <bitRange>[1:1]</bitRange>
            </field>
            <field>
              <name>URTHnSLIT</name>
              <description>Transmission interrupt timing (0=at start, 1=at completion)</description>
              <bitRange>[0:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>URTH0CTL2</name>
