            </field>
            <field>
              <name>CSIHnSLIT</name>
              <description>Interrupt timing select for CSIHnTIC</description>
              <bitRange>[16:16]</bitRange>
            </field>
            <field>
              <name>CSIHnCSL7</name>
              <description>Chip-select 7 active output level (0=active-low, 1=active-high)</description>
              <bitRange>[15:15]</bitRange>
            </field>
            <field>
              <name>CSIHnCSL6</name>
              <description>Chip-select 6 active output level</description>
              <bitRange>[14:14]</bitRange>
            </field>
            <field>
              <name>CSIHnCSL5</name>
              <description>Chip-select 5 active output level</description>
              <bitRange>[13:13]</bitRange>
            </field>
            <field>
              <name>CSIHnCSL4</name>
              <description>Chip-select 4 active output level</description>
              <bitRange>[12:12]</bitRange>
            </field>
            <field>
              <name>CSIHnCSL3</name>
              <description>Chip-select 3 active output level</description>
              <bitRange>[11:11]</bitRange>
            </field>
            <field>
              <name>CSIHnCSL2</name>
              <description>Chip-select 2 active output level</description>
              <bitRange>[10:10]</bitRange>
            </field>
            <field>
              <name>CSIHnCSL1</name>
              <description>Chip-select 1 active output level</description>
              <bitRange>[9:9]</bitRange>
            </field>
            <field>
              <name>CSIHnCSL0</name>
              <description>Chip-select 0 active output level</description>
              <bitRange>[8:8]</bitRange>
            </field>
            <field>
              <name>CSIHnEDLE</name>
              <description>Extended data length mode enable</description>
              <bitRange>[7:7]</bitRange>
            </field>
            <field>
              <name>CSIHnJE</name>
              <description>Job mode enable</description>
              <bitRange>[6:6]</bitRange>
            </field>
            <field>
              <name>CSIHnDCS</name>
              <description>Data consistency check enable</description>
              <bitRange>[5:5]</bitRange>
            </field>
            <field>
              <name>CSIHnCSRI</name>
              <description>Chip-select behavior after last transfer (0=hold active, 1=return inactive)</description>
              <bitRange>[4:4]</bitRange>
            </field>
            <field>
              <name>CSIHnLBM</name>
              <description>Loop-back mode enable</description>
              <bitRange>[3:3]</bitRange>
            </field>
            <field>
              <name>CSIHnSIT</name>
              <description>Interrupt delay mode (0=no delay, 1=half-clock delay)</description>
              <bitRange>[2:2]</bitRange>
            </field>
            <field>
              <name>CSIHnHSE</name>
              <description>Handshake function enable</description>
              <bitRange>[1:1]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>CSIH0CTL2</name>
          <description>CSIHn Control Register 2 — operating mode, prescaler, baud rate</description>
          <addressOffset>0x14</addressOffset>
          <size>16</size>
          <access>read-write</access>
          <resetValue>0xE000</resetValue>
          <fields>
            <field>
              <name>CSIHnPRS</name>
              <description>Prescaler select [2:0] (000=PCLK, 001=PCLK/2, ..., 111=slave ext clock)</description>
