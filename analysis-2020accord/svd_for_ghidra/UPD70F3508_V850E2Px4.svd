    <peripheral>
      <name>CSIG0_B0</name>
      <description>Clocked Serial Interface G 0 - base0 region (CTL1, CTL2, CFG0)</description>
      <baseAddress>0xFF700010</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x6</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x1000</offset>
        <size>0x4</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>CSIG0CTL1</name>
          <description>CSIG0 Control Register 1</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>CSIGnCKR</name>
              <description>Clock phase selection: 0=SCK default high, 1=SCK default low</description>
              <bitRange>[17:17]</bitRange>
            </field>
            <field>
              <name>CSIGnSLIT</name>
              <description>TIC interrupt timing: 0=after transfer, 1=when TX0W/H free</description>
              <bitRange>[16:16]</bitRange>
            </field>
            <field>
              <name>CSIGnEDLE</name>
              <description>Extended data length enable: 0=disabled, 1=enabled</description>
              <bitRange>[7:7]</bitRange>
            </field>
            <field>
              <name>CSIGnDCS</name>
              <description>Data consistency check enable: 0=disabled, 1=enabled</description>
              <bitRange>[5:5]</bitRange>
            </field>
            <field>
              <name>CSIGnLBM</name>
              <description>Loop-back mode: 0=deactivated, 1=activated</description>
              <bitRange>[3:3]</bitRange>
            </field>
            <field>
              <name>CSIGnSIT</name>
              <description>Interrupt delay: 0=no delay, 1=half-clock delay</description>
              <bitRange>[2:2]</bitRange>
            </field>
            <field>
              <name>CSIGnHSE</name>
              <description>Handshake enable: 0=disabled, 1=enabled</description>
              <bitRange>[1:1]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>CSIG0CTL2</name>
          <description>CSIG0 Control Register 2 - baud rate generator</description>
          <addressOffset>0x4</addressOffset>
          <size>16</size>
          <access>read-write</access>
          <resetValue>0xE000</resetValue>
          <fields>
            <field>
              <name>CSIGnPRS</name>
              <description>Prescaler select [2:0]: 000-110=PCLK/2^m master, 111=slave ext clock</description>
              <bitRange>[15:13]</bitRange>
            </field>
            <field>
              <name>CSIGnBRS</name>
              <description>Baud rate select [11:0]: 0=BRG stopped, 1-4095=divisor k</description>
              <bitRange>[11:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>CSIG0CFG0</name>
          <description>CSIG0 Configuration Register 0 - protocol, data length, parity, direction, clock/data phase</description>
          <addressOffset>0x1000</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>CSIGnPS</name>
              <description>Parity select [1:0]: 00=none, 01=fixed-0, 10=odd, 11=even</description>
              <bitRange>[29:28]</bitRange>
            </field>
            <field>
              <name>CSIGnDLS</name>
              <description>Data length select [3:0]: 0=16-bit, 1-15=N bits</description>
              <bitRange>[27:24]</bitRange>
            </field>
            <field>
              <name>CSIGnDIR</name>
              <description>Transfer direction: 0=MSB first, 1=LSB first</description>
              <bitRange>[18:18]</bitRange>
            </field>
            <field>
              <name>CSIGnDAP</name>
              <description>Data phase selection (used with CKR for SPI mode)</description>
              <bitRange>[16:16]</bitRange>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
