          <name>CSIG0TX0W</name>
          <description>CSIG0 Transmission Register 0 - word access (use with EDL)</description>
          <addressOffset>0x84</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>CSIGnEDL</name>
              <description>Extended data length: 0=normal, 1=transmit as 16-bit EDL block</description>
              <bitRange>[29:29]</bitRange>
            </field>
            <field>
              <name>CSIGnTX</name>
              <description>Transmit data [15:0]</description>
              <bitRange>[15:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>CSIG0TX0H</name>
          <description>CSIG0 Transmission Register 0 - half-word access (use without EDL)</description>
          <addressOffset>0x88</addressOffset>
          <size>16</size>
          <access>read-write</access>
          <resetValue>0x0000</resetValue>
