          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000010</resetValue>
          <fields>
            <field>
              <name>CSIGnTSF</name>
              <description>Transfer status: 0=idle, 1=transfer in progress or pending</description>
              <bitRange>[7:7]</bitRange>
            </field>
            <field>
              <name>CSIGnDCE</name>
              <description>Data consistency error flag: 0=none, 1=error detected</description>
              <bitRange>[3:3]</bitRange>
