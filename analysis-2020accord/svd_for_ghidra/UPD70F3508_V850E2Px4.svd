        <register>
          <name>TS1OPT0</name>
          <description>TSG2n Option Register 0</description>
          <addressOffset>0x7CDE20</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <fields>
            <field>
              <name>TS1SOC</name>
