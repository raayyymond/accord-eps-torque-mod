              <name>DTS0ACT</name>
              <description>DTS active; 1 = DTS is executing</description>
              <bitRange>[8:8]</bitRange>
            </field>
            <field>
              <name>DTS0CH6_0</name>
              <description>Active channel number [6:0]</description>
              <bitRange>[6:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>DTS0HST</name>
          <description>DTS TI Hold Status Register</description>
          <addressOffset>0x18</addressOffset>
