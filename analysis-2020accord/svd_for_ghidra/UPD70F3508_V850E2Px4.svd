    <peripheral>
      <name>CSIH0_B1</name>
      <description>Queue-Equipped Three-Line Serial Interface H 0, Bank 1 (memory/Tx/Rx/status registers at base1)</description>
      <baseAddress>0xFFFFE000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x9c</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>CSIH0CTL0</name>
          <description>CSIHn Control Register 0 — operation clock, Tx/Rx enable, memory bypass</description>
          <addressOffset>0x0</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <fields>
            <field>
              <name>CSIHnPWR</name>
              <description>Operation clock control (0=stop, 1=provide)</description>
              <bitRange>[7:7]</bitRange>
            </field>
            <field>
              <name>CSIHnTXE</name>
              <description>Transmission enable</description>
              <bitRange>[6:6]</bitRange>
            </field>
            <field>
              <name>CSIHnRXE</name>
              <description>Reception enable</description>
              <bitRange>[5:5]</bitRange>
            </field>
            <field>
              <name>CSIHnJOBE</name>
              <description>Job abort at end of current job</description>
              <bitRange>[1:1]</bitRange>
            </field>
            <field>
              <name>CSIHnMBS</name>
              <description>Memory bypass (0=memory mode, 1=direct access mode)</description>
              <bitRange>[0:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>CSIH0STR0</name>
          <description>CSIHn Status Register 0 — FIFO pointers, error flags, transfer status</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000010</resetValue>
          <fields>
            <field>
              <name>CSIHnSRP</name>
              <description>Received words in FIFO [7:0] (FIFO mode only)</description>
              <bitRange>[31:24]</bitRange>
            </field>
            <field>
              <name>CSIHnSPF</name>
              <description>Untransmitted data count in FIFO [7:0] (FIFO mode only)</description>
              <bitRange>[23:16]</bitRange>
            </field>
            <field>
              <name>CSIHnTMOE</name>
              <description>Time-out error flag</description>
              <bitRange>[15:15]</bitRange>
            </field>
            <field>
              <name>CSIHnOFE</name>
              <description>Overflow error flag</description>
              <bitRange>[14:14]</bitRange>
            </field>
            <field>
              <name>CSIHnTSF</name>
              <description>Transfer status flag (0=idle, 1=active)</description>
              <bitRange>[7:7]</bitRange>
            </field>
            <field>
              <name>CSIHnFLF</name>
              <description>FIFO full flag</description>
              <bitRange>[5:5]</bitRange>
            </field>
            <field>
              <name>CSIHnEMF</name>
              <description>FIFO empty flag</description>
              <bitRange>[4:4]</bitRange>
            </field>
            <field>
              <name>CSIHnDCE</name>
              <description>Data consistency check error flag</description>
              <bitRange>[3:3]</bitRange>
            </field>
            <field>
              <name>CSIHnPE</name>
              <description>Parity error flag</description>
              <bitRange>[1:1]</bitRange>
            </field>
            <field>
              <name>CSIHnOVE</name>
              <description>Overrun error flag</description>
              <bitRange>[0:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>CSIH0STCR0</name>
          <description>CSIHn Status Clear Register 0 — clears STR0 flags; always reads as 0x0000</description>
          <addressOffset>0x8</addressOffset>
          <size>16</size>
          <access>write-only</access>
          <resetValue>0x0000</resetValue>
          <fields>
            <field>
              <name>CSIHnTMOEC</name>
              <description>Clear time-out error flag (STR0.CSIHnTMOE)</description>
              <bitRange>[15:15]</bitRange>
            </field>
            <field>
              <name>CSIHnOFEC</name>
              <description>Clear overflow error flag (STR0.CSIHnOFE)</description>
              <bitRange>[14:14]</bitRange>
            </field>
            <field>
              <name>CSIHnPCT</name>
              <description>FIFO pointer clear command</description>
              <bitRange>[8:8]</bitRange>
            </field>
            <field>
              <name>CSIHnDCEC</name>
              <description>Clear data consistency error flag (STR0.CSIHnDCE)</description>
              <bitRange>[3:3]</bitRange>
            </field>
            <field>
              <name>CSIHnPEC</name>
              <description>Clear parity error flag (STR0.CSIHnPE)</description>
              <bitRange>[1:1]</bitRange>
            </field>
            <field>
              <name>CSIHnOVEC</name>
              <description>Clear overrun error flag (STR0.CSIHnOVE)</description>
              <bitRange>[0:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>CSIH0MCTL1</name>
          <description>CSIHn Memory Control Register 1 — FIFO interrupt threshold levels</description>
          <addressOffset>0x80</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>CSIHnFES</name>
              <description>Tx FIFO empty interrupt threshold [6:0] — CSIHnTIC generated when SPF reaches this value</description>
              <bitRange>[22:16]</bitRange>
            </field>
            <field>
              <name>CSIHnFFS</name>
              <description>Rx FIFO full interrupt threshold [6:0] — CSIHnTIR generated when (128-SRP) equals this</description>
              <bitRange>[6:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>CSIH0MCTL2</name>
          <description>CSIHn Memory Control Register 2 — buffer transfer start, data count, send pointer</description>
          <addressOffset>0x84</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>CSIHnBTST</name>
              <description>Buffer transfer start trigger (write 1; always reads 0)</description>
              <bitRange>[31:31]</bitRange>
            </field>
            <field>
              <name>CSIHnND</name>
              <description>Number of data for double-buffer/Tx-only-buffer mode [7:0]</description>
              <bitRange>[23:16]</bitRange>
            </field>
            <field>
              <name>CSIHnSOP</name>
              <description>Send pointer for Tx buffer [6:0]</description>
              <bitRange>[6:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>CSIH0TX0W</name>
          <description>CSIHn Transmission Register 0 for Word Access — Tx data + control flags + chip-select</description>
          <addressOffset>0x88</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>CSIHnCIRE</name>
              <description>Communication interrupt request enable for this frame</description>
              <bitRange>[31:31]</bitRange>
            </field>
            <field>
              <name>CSIHnEOJ</name>
              <description>End-of-job marker for this frame</description>
              <bitRange>[30:30]</bitRange>
            </field>
            <field>
              <name>CSIHnEDL</name>
              <description>Extended data length for this frame</description>
              <bitRange>[29:29]</bitRange>
            </field>
            <field>
              <name>CSIHnCS</name>
              <description>Chip-select activation bitmap [7:0] (0=activated, 1=deactivated)</description>
              <bitRange>[23:16]</bitRange>
            </field>
            <field>
              <name>CSIHnTX</name>
              <description>Transmission data [15:0]</description>
              <bitRange>[15:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>CSIH0TX0H</name>
          <description>CSIHn Transmission Register 0 for Half Word Access — same as TX0W[15:0]</description>
          <addressOffset>0x8C</addressOffset>
          <size>16</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>CSIHnTX</name>
              <description>Transmission data [15:0]</description>
              <bitRange>[15:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>CSIH0RX0W</name>
          <description>CSIHn Reception Register 0 for Word Access — received data + parity/consistency error flags + CS indicator</description>
          <addressOffset>0x90</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>CSIHnRPE</name>
              <description>Reception parity error on this frame</description>
              <bitRange>[25:25]</bitRange>
            </field>
            <field>
              <name>CSIHnTDCE</name>
              <description>Transmission data consistency error on this frame</description>
              <bitRange>[24:24]</bitRange>
            </field>
            <field>
              <name>CSIHnCS</name>
              <description>Chip-select active bitmap for this frame [7:0]</description>
              <bitRange>[23:16]</bitRange>
            </field>
            <field>
              <name>CSIHnRX</name>
              <description>Received data [15:0]</description>
              <bitRange>[15:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>CSIH0RX0H</name>
          <description>CSIHn Reception Register 0 for Half Word Access — same as RX0W[15:0]</description>
          <addressOffset>0x94</addressOffset>
          <size>16</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>CSIHnRX</name>
              <description>Received data [15:0]</description>
              <bitRange>[15:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>CSIH0MRWP0</name>
          <description>CSIHn Memory Read/Write Pointer Register 0 — Rx and Tx buffer pointers</description>
          <addressOffset>0x98</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>CSIHnRRA</name>
              <description>Rx buffer read pointer [6:0]</description>
              <bitRange>[22:16]</bitRange>
            </field>
            <field>
              <name>CSIHnTRWA</name>
              <description>Tx buffer read/write pointer [6:0]</description>
              <bitRange>[6:0]</bitRange>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
