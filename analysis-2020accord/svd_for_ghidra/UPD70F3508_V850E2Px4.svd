    <peripheral>
      <name>CSIH0_B0</name>
      <description>Queue-Equipped Three-Line Serial Interface H 0, Bank 0 (control/config registers at base0)</description>
      <baseAddress>0xFF6C0000</baseAddress>
      <addressBlock>
        <offset>0x10</offset>
        <size>0x6</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x1040</offset>
        <size>0x24</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>CSIH0CTL1</name>
          <description>CSIHn Control Register 1 — clock phase, interrupt timing, chip-select levels, job/loop-back/handshake modes</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>CSIHnCKR</name>
              <description>Clock phase of CSIHnTSCK (0=default high, 1=default low)</description>
