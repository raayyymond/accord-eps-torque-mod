    <!-- Timer I/O control registers (TAUA1 group, n=1) -->

    <register>
      <name>PIC0REG210</name>
      <description>Timer I/O control register 210 (PIC0REG2n0, n=1) — selects TIN input signal for TAUA1; used by high-accuracy triangle-wave PWM and three-phase pulse input functions</description>
      <addressOffset>0x01C</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <fields>
        <field><name>PIC0REG21011</name><description>TS1PET signal select (high bits) for three-phase pulse input (TAUA1)</description><bitRange>[11:11]</bitRange></field>
        <field><name>PIC0REG21010</name><description>TS1PET signal select (low bits) for three-phase pulse input (TAUA1)</description><bitRange>[10:10]</bitRange></field>
        <field><name>PIC0REG21009</name><description>TS1PET signal select (high bits) for three-phase pulse input (TAUA1)</description><bitRange>[9:9]</bitRange></field>
        <field><name>PIC0REG21008</name><description>TS1PET signal select (low bits) for three-phase pulse input (TAUA1)</description><bitRange>[8:8]</bitRange></field>
        <field><name>PIC0REG21003</name><description>Select TAUA1 TAI107 pin or TS1PTE signal of TSG21</description><bitRange>[3:3]</bitRange></field>
