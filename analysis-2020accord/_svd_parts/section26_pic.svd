<!-- PIC0_CTRL: isolated control registers at addresses outside the main cluster -->
<!-- PIC0EN at 0xFF81DB00 (register detail page) / 0xFFFFDB00 (Table 26-2) — see note at top of file -->
<!-- PIC0SST at 0xFFFFDB04 (confirmed in both sources) -->
<!-- These two registers are in separate address ranges; baseAddress set to the lower (PIC0EN detail-page address) -->

<peripheral>
  <name>PIC0_CTRL</name>
  <description>Peripheral Interconnection Controller 0 — isolated control registers (PIC0EN enable + PIC0SST simultaneous start trigger)</description>
  <!-- Note: PIC0EN address 0xFF81DB00 is from register detail page 1847; Table 26-2 lists 0xFFFFDB00.
             PIC0SST address 0xFFFFDB04 is confirmed in both sources.
             These registers are NOT contiguous — PIC0EN and PIC0SST differ by 0x7E020004 bytes if using
             the respective confirmed addresses. Placing both under PIC0EN base with correct offsets. -->
  <baseAddress>0xFF81DB00</baseAddress>
  <addressBlock>
    <offset>0x0</offset>
    <size>0x4</size>
    <usage>registers</usage>
  </addressBlock>
  <registers>

    <register>
      <name>PIC0EN</name>
      <description>Control register EN — enables or disables all PIC functions (PIC0EN0 bit)</description>
      <!-- Address 0xFF81DB00 per detail page; Table 26-2 lists 0xFFFFDB00 — discrepancy noted -->
      <addressOffset>0x000</addressOffset>
      <size>8</size>
      <access>read-write</access>
      <resetValue>0x00</resetValue>
      <fields>
        <field><name>PIC0EN0</name><description>Enable PIC functions (0=disable, 1=enable)</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>

  </registers>
</peripheral>

<!-- PIC0_SST: PIC0SST simultaneous start trigger register at 0xFFFFDB04 -->
<!-- Placed as a separate peripheral because its address (0xFFFFDB04) cannot share a baseAddress
     with PIC0EN (0xFF81DB00) without creating an implausibly large addressBlock. -->

<peripheral>
  <name>PIC0_SST</name>
  <description>Peripheral Interconnection Controller 0 — Simultaneous Start Trigger register</description>
  <baseAddress>0xFFFFDB04</baseAddress>
  <addressBlock>
    <offset>0x0</offset>
    <size>0x1</size>
    <usage>registers</usage>
  </addressBlock>
  <registers>

    <register>
      <name>PIC0SST</name>
      <description>Simultaneous start trigger control register — write 1 to SYNCTRG to generate simultaneous start pulse</description>
      <addressOffset>0x000</addressOffset>
      <size>8</size>
      <access>write-only</access>
      <resetValue>0x00</resetValue>
      <fields>
        <field><name>SYNCTRG</name><description>Generate simultaneous start trigger (write 1 = output 1-PCLK-wide pulse; always reads 0)</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>

  </registers>
</peripheral>
