      <name>PIC0REG203</name>
      <description>Timer I/O control register 203 (PIC0REG2n3, n=0) — logical operation circuit select for TAUA0 high-accuracy triangle-wave PWM with dead time</description>
      <addressOffset>0x018</addressOffset>
