      </fields>
    </register>

    <register>
      <name>PIC0REG211</name>
      <description>Timer I/O control register 211 (PIC0REG2n1, n=1) — selects TIN input signal for TAUA1 one-phase PWM; combinational circuit input select</description>
      <addressOffset>0x020</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <!-- Fields identical in structure to PIC0REG201; bit names use n=1 suffix implicitly -->
      <fields>
        <field><name>PIC0REG211_27</name><description>Select A input of FN05 per TOL of TAUA1 CH09 (bit 27)</description><bitRange>[27:27]</bitRange></field>
        <field><name>PIC0REG211_26</name><description>Select A input of FN05 per TOL of TAUA1 CH09 (bit 26)</description><bitRange>[26:26]</bitRange></field>
        <field><name>PIC0REG211_25</name><description>Select A input of FN04 per TOL of TAUA1 CH08 (bit 25)</description><bitRange>[25:25]</bitRange></field>
        <field><name>PIC0REG211_24</name><description>Select A input of FN04 per TOL of TAUA1 CH08 (bit 24)</description><bitRange>[24:24]</bitRange></field>
        <field><name>PIC0REG211_23</name><description>Select A input of FN03 per TOL of TAUA1 CH07 (bit 23)</description><bitRange>[23:23]</bitRange></field>
        <field><name>PIC0REG211_22</name><description>Select A input of FN03 per TOL of TAUA1 CH07 (bit 22)</description><bitRange>[22:22]</bitRange></field>
        <field><name>PIC0REG211_21</name><description>Select A input of FN02 per TOL of TAUA1 CH06 (bit 21)</description><bitRange>[21:21]</bitRange></field>
        <field><name>PIC0REG211_20</name><description>Select A input of FN02 per TOL of TAUA1 CH06 (bit 20)</description><bitRange>[20:20]</bitRange></field>
        <field><name>PIC0REG211_19</name><description>Select A input of FN01 per TOL of TAUA1 CH05 (bit 19)</description><bitRange>[19:19]</bitRange></field>
        <field><name>PIC0REG211_18</name><description>Select A input of FN01 per TOL of TAUA1 CH05 (bit 18)</description><bitRange>[18:18]</bitRange></field>
        <field><name>PIC0REG211_17</name><description>Select A input of FN00 per TOL of TAUA1 CH04 (bit 17)</description><bitRange>[17:17]</bitRange></field>
        <field><name>PIC0REG211_16</name><description>Select A input of FN00 per TOL of TAUA1 CH04 (bit 16)</description><bitRange>[16:16]</bitRange></field>
      </fields>
    </register>

    <register>
      <name>PIC0REG212</name>
      <description>Timer I/O control register 212 (PIC0REG2n2, n=1) — selects TIN input signal for TAUA1 one-phase PWM / three-phase PWM output functions</description>
      <addressOffset>0x024</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <fields>
