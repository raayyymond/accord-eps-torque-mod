      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <fields>
        <field><name>PIC0REG2n322</name><description>Logical operation select for TAUA0 CH09 (bit 22)</description><bitRange>[22:22]</bitRange></field>
