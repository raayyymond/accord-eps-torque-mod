<!-- Section 26: Peripheral Interconnection (PIC) — UPD70F3508 V850E2/Px4
     Source: UPD70F3508GJA2-GBG-AX-1.pdf, pages 1842-2025 (Table 26-2 + per-register detail)
     Peripherals emitted: PIC0 (main cluster FF81C080..FF81C0E8), PIC0_CTRL (isolated control registers)

     Address notes:
       PIC0EN: Table 26-2 lists FFFF DB00H; detail page 1847 (section 26.3.1) lists FF81 DB00H.
               Using FF81 DB00H (detail page). Both addresses documented; possible aliasing.
       PIC0SST: FFFF DB04H confirmed in both table 26-2 and detail page 1853.
       PIC0HIZCEN0 / PIC0HIZCEN1: Addresses from Table 26-2 only (FF81C0B4 / FF81C0B8).
               No per-register detail subsection found in section 26; bit-level fields omitted.
-->

<peripheral>
  <name>PIC0</name>
  <description>Peripheral Interconnection Controller 0 — main register cluster</description>
  <baseAddress>0xFF81C080</baseAddress>
  <addressBlock>
    <offset>0x0</offset>
    <size>0x6C</size>
    <usage>registers</usage>
  </addressBlock>
  <registers>

    <!-- Simultaneous Start Trigger Function registers -->

    <register>
      <name>PIC0SSER0</name>
      <description>Simultaneous start control register 0 — enables simultaneous start trigger for TAUA0 channels</description>
      <addressOffset>0x000</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field><name>PIC0SSER015</name><description>Enable simultaneous start trigger for TAUA0 CH15</description><bitRange>[15:15]</bitRange></field>
        <field><name>PIC0SSER014</name><description>Enable simultaneous start trigger for TAUA0 CH14</description><bitRange>[14:14]</bitRange></field>
        <field><name>PIC0SSER013</name><description>Enable simultaneous start trigger for TAUA0 CH13</description><bitRange>[13:13]</bitRange></field>
        <field><name>PIC0SSER012</name><description>Enable simultaneous start trigger for TAUA0 CH12</description><bitRange>[12:12]</bitRange></field>
        <field><name>PIC0SSER011</name><description>Enable simultaneous start trigger for TAUA0 CH11</description><bitRange>[11:11]</bitRange></field>
        <field><name>PIC0SSER010</name><description>Enable simultaneous start trigger for TAUA0 CH10</description><bitRange>[10:10]</bitRange></field>
        <field><name>PIC0SSER009</name><description>Enable simultaneous start trigger for TAUA0 CH09</description><bitRange>[9:9]</bitRange></field>
        <field><name>PIC0SSER008</name><description>Enable simultaneous start trigger for TAUA0 CH08</description><bitRange>[8:8]</bitRange></field>
        <field><name>PIC0SSER007</name><description>Enable simultaneous start trigger for TAUA0 CH07</description><bitRange>[7:7]</bitRange></field>
        <field><name>PIC0SSER006</name><description>Enable simultaneous start trigger for TAUA0 CH06</description><bitRange>[6:6]</bitRange></field>
        <field><name>PIC0SSER005</name><description>Enable simultaneous start trigger for TAUA0 CH05</description><bitRange>[5:5]</bitRange></field>
        <field><name>PIC0SSER004</name><description>Enable simultaneous start trigger for TAUA0 CH04</description><bitRange>[4:4]</bitRange></field>
        <field><name>PIC0SSER003</name><description>Enable simultaneous start trigger for TAUA0 CH03</description><bitRange>[3:3]</bitRange></field>
        <field><name>PIC0SSER002</name><description>Enable simultaneous start trigger for TAUA0 CH02</description><bitRange>[2:2]</bitRange></field>
        <field><name>PIC0SSER001</name><description>Enable simultaneous start trigger for TAUA0 CH01</description><bitRange>[1:1]</bitRange></field>
        <field><name>PIC0SSER000</name><description>Enable simultaneous start trigger for TAUA0 CH00</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>

    <register>
      <name>PIC0SSER1</name>
      <description>Simultaneous start control register 1 — enables simultaneous start trigger for TAUA1 channels</description>
      <addressOffset>0x004</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field><name>PIC0SSER115</name><description>Enable simultaneous start trigger for TAUA1 CH15</description><bitRange>[15:15]</bitRange></field>
        <field><name>PIC0SSER114</name><description>Enable simultaneous start trigger for TAUA1 CH14</description><bitRange>[14:14]</bitRange></field>
        <field><name>PIC0SSER113</name><description>Enable simultaneous start trigger for TAUA1 CH13</description><bitRange>[13:13]</bitRange></field>
        <field><name>PIC0SSER112</name><description>Enable simultaneous start trigger for TAUA1 CH12</description><bitRange>[12:12]</bitRange></field>
        <field><name>PIC0SSER111</name><description>Enable simultaneous start trigger for TAUA1 CH11</description><bitRange>[11:11]</bitRange></field>
        <field><name>PIC0SSER110</name><description>Enable simultaneous start trigger for TAUA1 CH10</description><bitRange>[10:10]</bitRange></field>
        <field><name>PIC0SSER109</name><description>Enable simultaneous start trigger for TAUA1 CH09</description><bitRange>[9:9]</bitRange></field>
        <field><name>PIC0SSER108</name><description>Enable simultaneous start trigger for TAUA1 CH08</description><bitRange>[8:8]</bitRange></field>
        <field><name>PIC0SSER107</name><description>Enable simultaneous start trigger for TAUA1 CH07</description><bitRange>[7:7]</bitRange></field>
        <field><name>PIC0SSER106</name><description>Enable simultaneous start trigger for TAUA1 CH06</description><bitRange>[6:6]</bitRange></field>
        <field><name>PIC0SSER105</name><description>Enable simultaneous start trigger for TAUA1 CH05</description><bitRange>[5:5]</bitRange></field>
        <field><name>PIC0SSER104</name><description>Enable simultaneous start trigger for TAUA1 CH04</description><bitRange>[4:4]</bitRange></field>
        <field><name>PIC0SSER103</name><description>Enable simultaneous start trigger for TAUA1 CH03</description><bitRange>[3:3]</bitRange></field>
        <field><name>PIC0SSER102</name><description>Enable simultaneous start trigger for TAUA1 CH02</description><bitRange>[2:2]</bitRange></field>
        <field><name>PIC0SSER101</name><description>Enable simultaneous start trigger for TAUA1 CH01</description><bitRange>[1:1]</bitRange></field>
        <field><name>PIC0SSER100</name><description>Enable simultaneous start trigger for TAUA1 CH00</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>

    <register>
      <name>PIC0SSER2</name>
      <description>Simultaneous start control register 2 — enables simultaneous start trigger for TAUJ/TSG2/TPBA/OSTM/ENCA</description>
      <addressOffset>0x008</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field><name>PIC0SSER215</name><description>Enable simultaneous start trigger for ENCA1</description><bitRange>[15:15]</bitRange></field>
        <field><name>PIC0SSER214</name><description>Enable simultaneous start trigger for ENCA0</description><bitRange>[14:14]</bitRange></field>
        <field><name>PIC0SSER213</name><description>Enable simultaneous start trigger for OSTM1</description><bitRange>[13:13]</bitRange></field>
        <field><name>PIC0SSER212</name><description>Enable simultaneous start trigger for OSTM0</description><bitRange>[12:12]</bitRange></field>
        <field><name>PIC0SSER211</name><description>Enable simultaneous start trigger for TPBA1</description><bitRange>[11:11]</bitRange></field>
        <field><name>PIC0SSER210</name><description>Enable simultaneous start trigger for TPBA0</description><bitRange>[10:10]</bitRange></field>
        <field><name>PIC0SSER209</name><description>Enable simultaneous start trigger for TSG21</description><bitRange>[9:9]</bitRange></field>
        <field><name>PIC0SSER208</name><description>Enable simultaneous start trigger for TSG20</description><bitRange>[8:8]</bitRange></field>
        <field><name>PIC0SSER207</name><description>Enable simultaneous start trigger for TAUJ1 CH03</description><bitRange>[7:7]</bitRange></field>
        <field><name>PIC0SSER206</name><description>Enable simultaneous start trigger for TAUJ1 CH02</description><bitRange>[6:6]</bitRange></field>
        <field><name>PIC0SSER205</name><description>Enable simultaneous start trigger for TAUJ1 CH01</description><bitRange>[5:5]</bitRange></field>
        <field><name>PIC0SSER204</name><description>Enable simultaneous start trigger for TAUJ1 CH00</description><bitRange>[4:4]</bitRange></field>
        <field><name>PIC0SSER203</name><description>Enable simultaneous start trigger for TAUJ0 CH03</description><bitRange>[3:3]</bitRange></field>
        <field><name>PIC0SSER202</name><description>Enable simultaneous start trigger for TAUJ0 CH02</description><bitRange>[2:2]</bitRange></field>
        <field><name>PIC0SSER201</name><description>Enable simultaneous start trigger for TAUJ0 CH01</description><bitRange>[1:1]</bitRange></field>
        <field><name>PIC0SSER200</name><description>Enable simultaneous start trigger for TAUJ0 CH00</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>

    <!-- Timer I/O control registers (TAUA0 group, n=0) -->

    <register>
      <name>PIC0REG200</name>
      <description>Timer I/O control register 200 (PIC0REG2n0, n=0) — selects TIN input signal for TAUA0; used by high-accuracy triangle-wave PWM and three-phase pulse input functions</description>
      <addressOffset>0x00C</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <fields>
        <!-- Bits 11:8 used by three-phase pulse input function (26.4.10) -->
        <field><name>PIC0REG20011</name><description>TS0PET signal select (high bits) for three-phase pulse input (TAUA0)</description><bitRange>[11:11]</bitRange></field>
        <field><name>PIC0REG20010</name><description>TS0PET signal select (low bits) for three-phase pulse input (TAUA0)</description><bitRange>[10:10]</bitRange></field>
        <field><name>PIC0REG20009</name><description>TS0PET signal select (high bits) for three-phase pulse input (TAUA0)</description><bitRange>[9:9]</bitRange></field>
        <field><name>PIC0REG20008</name><description>TS0PET signal select (low bits) for three-phase pulse input (TAUA0)</description><bitRange>[8:8]</bitRange></field>
        <!-- Bits 3:0 used by three-phase pulse input function (26.4.10) -->
        <field><name>PIC0REG20003</name><description>Select TAUA0 TAI007 pin or TS0PTE signal of TSG20</description><bitRange>[3:3]</bitRange></field>
        <field><name>PIC0REG20002</name><description>Select TAUA0 TAI006 pin or TS0PTE signal of TSG20</description><bitRange>[2:2]</bitRange></field>
        <field><name>PIC0REG20001</name><description>Select TAUA0 TAI005 pin or TS0PTE signal of TSG20</description><bitRange>[1:1]</bitRange></field>
        <field><name>PIC0REG20000</name><description>Select TAUA0 TAI004 pin or TS0PTE signal of TSG20</description><bitRange>[0:0]</bitRange></field>
        <!-- Note: bit 18 (PIC0REG2n018) used by high-accuracy triangle-wave function (26.4.4) -->
        <field><name>PIC0REG20018</name><description>Select TIN input of TAUA0 CH10/CH12/CH14 — selects TOUT of TAUA0 CH02 when set</description><bitRange>[18:18]</bitRange></field>
      </fields>
    </register>

    <register>
      <name>PIC0REG201</name>
      <description>Timer I/O control register 201 (PIC0REG2n1, n=0) — selects TIN input signal for TAUA0 one-phase PWM; combinational circuit input select</description>
      <addressOffset>0x010</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <fields>
        <field><name>PIC0REG2n127</name><description>Select A input of FN05 per TOL of TAUA0 CH09 (bit 27)</description><bitRange>[27:27]</bitRange></field>
        <field><name>PIC0REG2n126</name><description>Select A input of FN05 per TOL of TAUA0 CH09 (bit 26)</description><bitRange>[26:26]</bitRange></field>
        <field><name>PIC0REG2n125</name><description>Select A input of FN04 per TOL of TAUA0 CH08 (bit 25)</description><bitRange>[25:25]</bitRange></field>
        <field><name>PIC0REG2n124</name><description>Select A input of FN04 per TOL of TAUA0 CH08 (bit 24)</description><bitRange>[24:24]</bitRange></field>
        <field><name>PIC0REG2n123</name><description>Select A input of FN03 per TOL of TAUA0 CH07 (bit 23)</description><bitRange>[23:23]</bitRange></field>
        <field><name>PIC0REG2n122</name><description>Select A input of FN03 per TOL of TAUA0 CH07 (bit 22)</description><bitRange>[22:22]</bitRange></field>
        <field><name>PIC0REG2n121</name><description>Select A input of FN02 per TOL of TAUA0 CH06 (bit 21)</description><bitRange>[21:21]</bitRange></field>
        <field><name>PIC0REG2n120</name><description>Select A input of FN02 per TOL of TAUA0 CH06 (bit 20)</description><bitRange>[20:20]</bitRange></field>
        <field><name>PIC0REG2n119</name><description>Select A input of FN01 per TOL of TAUA0 CH05 (bit 19)</description><bitRange>[19:19]</bitRange></field>
        <field><name>PIC0REG2n118</name><description>Select A input of FN01 per TOL of TAUA0 CH05 (bit 18)</description><bitRange>[18:18]</bitRange></field>
        <field><name>PIC0REG2n117</name><description>Select A input of FN00 per TOL of TAUA0 CH04 (bit 17)</description><bitRange>[17:17]</bitRange></field>
        <field><name>PIC0REG2n116</name><description>Select A input of FN00 per TOL of TAUA0 CH04 (bit 16)</description><bitRange>[16:16]</bitRange></field>
      </fields>
    </register>

    <register>
      <name>PIC0REG202</name>
      <description>Timer I/O control register 202 (PIC0REG2n2, n=0) — selects TIN input signal for TAUA0 one-phase PWM output / three-phase PWM output functions</description>
      <addressOffset>0x014</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <fields>
        <field><name>PIC0REG2n227</name><description>Select TIN input of TAUA0 CH15 (bit 27 — upper of pair)</description><bitRange>[27:27]</bitRange></field>
        <field><name>PIC0REG2n226</name><description>Select TIN input of TAUA0 CH15 (bit 26 — lower of pair)</description><bitRange>[26:26]</bitRange></field>
        <field><name>PIC0REG2n225</name><description>Select TIN input of TAUA0 CH14 (bit 25 — upper of pair; high-accuracy triangle-wave)</description><bitRange>[25:25]</bitRange></field>
        <field><name>PIC0REG2n224</name><description>Select TIN input of TAUA0 CH14 (bit 24 — lower of pair; high-accuracy triangle-wave)</description><bitRange>[24:24]</bitRange></field>
        <field><name>PIC0REG2n223</name><description>Select TIN input of TAUA0 CH13 (bit 23 — upper of pair)</description><bitRange>[23:23]</bitRange></field>
        <field><name>PIC0REG2n222</name><description>Select TIN input of TAUA0 CH13 (bit 22 — lower of pair)</description><bitRange>[22:22]</bitRange></field>
        <field><name>PIC0REG2n221</name><description>Select TIN input of TAUA0 CH12 (bit 21 — upper of pair; high-accuracy triangle-wave)</description><bitRange>[21:21]</bitRange></field>
        <field><name>PIC0REG2n220</name><description>Select TIN input of TAUA0 CH12 (bit 20 — lower of pair; high-accuracy triangle-wave)</description><bitRange>[20:20]</bitRange></field>
        <field><name>PIC0REG2n219</name><description>Select TIN input of TAUA0 CH11 (bit 19 — upper of pair)</description><bitRange>[19:19]</bitRange></field>
        <field><name>PIC0REG2n218</name><description>Select TIN input of TAUA0 CH11 (bit 18 — lower of pair)</description><bitRange>[18:18]</bitRange></field>
        <field><name>PIC0REG2n217</name><description>Select TIN input of TAUA0 CH10 (bit 17 — upper of pair; high-accuracy triangle-wave)</description><bitRange>[17:17]</bitRange></field>
        <field><name>PIC0REG2n216</name><description>Select TIN input of TAUA0 CH10 (bit 16 — lower of pair; high-accuracy triangle-wave)</description><bitRange>[16:16]</bitRange></field>
        <field><name>PIC0REG2n204</name><description>Select TIN signal for TAUA0 CH15 (0=TOUT from CH09)</description><bitRange>[4:4]</bitRange></field>
        <field><name>PIC0REG2n203</name><description>Select TIN signal for TAUA0 CH13 (0=TOUT from CH07)</description><bitRange>[3:3]</bitRange></field>
        <field><name>PIC0REG2n202</name><description>Select TIN signal for TAUA0 CH11 (0=TOUT from CH05)</description><bitRange>[2:2]</bitRange></field>
      </fields>
    </register>

