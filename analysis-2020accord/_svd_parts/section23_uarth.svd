  </registers>
</peripheral>

<!-- ═══════════════════════════════════════════════════════ UARTH_IC0 -->
<!-- Singleton LIN baud-rate detection registers (not instance-specific) -->
<!-- Addresses FFFFFE00H and FFFFFE04H from Table 23-7 (PDF p.1475) -->
<peripheral>
  <name>UARTH_IC0</name>
  <description>LIN Communications Slave Operation Baud-Rate Detection Registers (IC0REG0/IC0REG1)</description>
  <baseAddress>0xFFFFFE00</baseAddress>
  <addressBlock><offset>0x0</offset><size>0x8</size><usage>registers</usage></addressBlock>
  <registers>

    <register>
      <name>IC0REG0</name>
      <description>LIN Baud-Rate Detection Register 0 — TAUA0 channel input selection</description>
      <addressOffset>0x0</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <!-- Each channel m (0-15) has 2-bit field IC0REG00m1:IC0REG00m0 -->
      <!-- Selecting input to TAUA0 ch(m): 00=TAUA0Im, 01=RXDH0, 10=RXDH1, 11=RXDH2 -->
      <!-- Fields not individually enumerated (32 packed 1-bit sub-fields) -->
    </register>

    <register>
      <name>IC0REG1</name>
      <description>LIN Baud-Rate Detection Register 1 — TAUA1 channel input selection</description>
      <addressOffset>0x4</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <!-- Each channel m (0-15) has 2-bit field IC0REG11m1:IC0REG11m0 -->
      <!-- Selecting input to TAUA1 ch(m): 00=TAUA1Im, 01=RXDH0, 10=RXDH1, 11=RXDH2 -->
    </register>

  </registers>
</peripheral>
