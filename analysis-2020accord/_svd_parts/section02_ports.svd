<!-- ============================================================ -->
<!-- JTAG_PORT0: JTAG port 0 (absolute addresses, Table 2-8)     -->
<!-- baseAddress = JP0 = 0xFF440000                              -->
<!-- ============================================================ -->
<peripheral>
  <name>JTAG_PORT0</name>
  <description>JTAG port 0 control registers (Table 2-8)</description>
  <baseAddress>0xFF440000</baseAddress>
  <addressBlock><offset>0x0</offset><size>0x434</size><usage>registers</usage></addressBlock>
  <registers>

    <register>
      <name>JP0</name>
      <description>JTAG port register (JP0_0 = TDI/TMS/TCK/TRST)</description>
      <addressOffset>0x0000</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
    </register>

    <register>
      <name>JPSR0</name>
      <description>JTAG port set / reset register</description>
      <addressOffset>0x0010</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
    </register>

    <register>
      <name>JPPR0</name>
      <description>JTAG port pin read register</description>
      <addressOffset>0x0020</addressOffset>
      <size>16</size>
      <access>read-only</access>
      <resetValue>0x0000</resetValue>
    </register>

    <register>
      <name>JPM0</name>
      <description>JTAG port mode register (0=output, 1=input)</description>
      <addressOffset>0x0030</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0xFFFF</resetValue>
    </register>

    <register>
      <name>JPNOT0</name>
      <description>JTAG port NOT register</description>
      <addressOffset>0x0070</addressOffset>
      <size>16</size>
      <access>write-only</access>
      <resetValue>0x0000</resetValue>
    </register>

    <register>
      <name>JPMSR0</name>
      <description>JTAG port mode set register</description>
      <addressOffset>0x0080</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x0000FFFF</resetValue>
    </register>

    <register>
      <name>JPIBC0</name>
      <description>JTAG port input buffer control register</description>
      <addressOffset>0x0400</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
    </register>

    <register>
      <name>JPU0</name>
      <description>JTAG pull-up option register</description>
      <addressOffset>0x0430</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
    </register>

  </registers>
</peripheral>

<!-- ============================================================ -->
<!-- DNF: Digital Noise Filter (n=0..36)                          -->
<!-- baseAddress = DNFn_base = 0xFF410000                        -->
<!-- DNFAnCTL at base + n*0x100                                  -->
<!-- DNFAnEN  at base + n*0x100 + 4                              -->
<!-- DNFSCTL  at 0xFF420034 (outside this peripheral's range -   -->
<!--           emitted separately)                               -->
<!-- ============================================================ -->
<peripheral>
  <name>DNF</name>
  <description>Digital noise filter control registers (n=0..36, Table 2-58/2-59/2-61)</description>
  <baseAddress>0xFF410000</baseAddress>
  <addressBlock><offset>0x0</offset><size>0x2408</size><usage>registers</usage></addressBlock>
  <registers>

    <!-- DNFA0: NMI filter -->
    <register><name>DNFA0CTL</name><description>DNF group 0 (NMI) control register</description><addressOffset>0x0000</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue>
      <fields>
        <field><name>DNFAnNFSTS</name><description>Number of same-level samples for validation [6:5]</description><bitRange>[6:5]</bitRange></field>
        <field><name>DNFAnPRS</name><description>Sampling clock prescaler [2:0]</description><bitRange>[2:0]</bitRange></field>
      </fields>
    </register>
    <register><name>DNFA0EN</name><description>DNF group 0 (NMI) enable register</description><addressOffset>0x0004</addressOffset><size>16</size><access>read-write</access><resetValue>0x0000</resetValue>
      <fields><field><name>DNFA0NFEN0</name><description>NMI noise cancellation enable</description><bitRange>[0:0]</bitRange></field></fields>
    </register>

    <!-- DNFA1: INTP0/1/2 -->
    <register><name>DNFA1CTL</name><description>DNF group 1 (INTP0/1/2) control register</description><addressOffset>0x0100</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DNFA1EN</name><description>DNF group 1 (INTP0/1/2) enable register</description><addressOffset>0x0104</addressOffset><size>16</size><access>read-write</access><resetValue>0x0000</resetValue>
      <fields>
        <field><name>DNFA1NFEN2</name><description>INTP2 noise cancellation enable</description><bitRange>[2:2]</bitRange></field>
        <field><name>DNFA1NFEN1</name><description>INTP1 noise cancellation enable</description><bitRange>[1:1]</bitRange></field>
        <field><name>DNFA1NFEN0</name><description>INTP0 noise cancellation enable</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>

    <!-- DNFA2: INTP3/4/5 (shared with ADCA0TRG0/1/2) -->
    <register><name>DNFA2CTL</name><description>DNF group 2 (INTP3/4/5) control register</description><addressOffset>0x0200</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DNFA2EN</name><description>DNF group 2 (INTP3/4/5) enable register</description><addressOffset>0x0204</addressOffset><size>16</size><access>read-write</access><resetValue>0x0000</resetValue></register>

    <!-- DNFA3: INTP6/7/8/9/10 (shared with ESO0-3) -->
    <register><name>DNFA3CTL</name><description>DNF group 3 (INTP6..10) control register</description><addressOffset>0x0300</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DNFA3EN</name><description>DNF group 3 (INTP6..10) enable register</description><addressOffset>0x0304</addressOffset><size>16</size><access>read-write</access><resetValue>0x0000</resetValue></register>

    <!-- DNFA4..11: TAUA0 I/O channels -->
    <register><name>DNFA4CTL</name><description>DNF group 4 (TAUA0I0/1) control register</description><addressOffset>0x0400</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DNFA4EN</name><description>DNF group 4 enable register</description><addressOffset>0x0404</addressOffset><size>16</size><access>read-write</access><resetValue>0x0000</resetValue></register>

    <register><name>DNFA5CTL</name><description>DNF group 5 (TAUA0I2/3) control register</description><addressOffset>0x0500</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DNFA5EN</name><description>DNF group 5 enable register</description><addressOffset>0x0504</addressOffset><size>16</size><access>read-write</access><resetValue>0x0000</resetValue></register>

    <register><name>DNFA6CTL</name><description>DNF group 6 (TAUA0I4/5) control register</description><addressOffset>0x0600</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DNFA6EN</name><description>DNF group 6 enable register</description><addressOffset>0x0604</addressOffset><size>16</size><access>read-write</access><resetValue>0x0000</resetValue></register>

    <register><name>DNFA7CTL</name><description>DNF group 7 (TAUA0I6/7) control register</description><addressOffset>0x0700</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DNFA7EN</name><description>DNF group 7 enable register</description><addressOffset>0x0704</addressOffset><size>16</size><access>read-write</access><resetValue>0x0000</resetValue></register>

    <register><name>DNFA8CTL</name><description>DNF group 8 (TAUA0I8/9) control register</description><addressOffset>0x0800</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DNFA8EN</name><description>DNF group 8 enable register</description><addressOffset>0x0804</addressOffset><size>16</size><access>read-write</access><resetValue>0x0000</resetValue></register>

    <register><name>DNFA9CTL</name><description>DNF group 9 (TAUA0I10/11) control register</description><addressOffset>0x0900</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DNFA9EN</name><description>DNF group 9 enable register</description><addressOffset>0x0904</addressOffset><size>16</size><access>read-write</access><resetValue>0x0000</resetValue></register>

    <register><name>DNFA10CTL</name><description>DNF group 10 (TAUA0I12/13) control register</description><addressOffset>0x0A00</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DNFA10EN</name><description>DNF group 10 enable register</description><addressOffset>0x0A04</addressOffset><size>16</size><access>read-write</access><resetValue>0x0000</resetValue></register>

    <register><name>DNFA11CTL</name><description>DNF group 11 (TAUA0I14/15) control register</description><addressOffset>0x0B00</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DNFA11EN</name><description>DNF group 11 enable register</description><addressOffset>0x0B04</addressOffset><size>16</size><access>read-write</access><resetValue>0x0000</resetValue></register>

    <!-- DNFA12..19: TAUA1 -->
    <register><name>DNFA12CTL</name><description>DNF group 12 (TAUA1I0/1) control register</description><addressOffset>0x0C00</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DNFA12EN</name><description>DNF group 12 enable register</description><addressOffset>0x0C04</addressOffset><size>16</size><access>read-write</access><resetValue>0x0000</resetValue></register>

    <register><name>DNFA13CTL</name><description>DNF group 13 (TAUA1I2/3) control register</description><addressOffset>0x0D00</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DNFA13EN</name><description>DNF group 13 enable register</description><addressOffset>0x0D04</addressOffset><size>16</size><access>read-write</access><resetValue>0x0000</resetValue></register>

    <register><name>DNFA14CTL</name><description>DNF group 14 (TAUA1I4/5) control register</description><addressOffset>0x0E00</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DNFA14EN</name><description>DNF group 14 enable register</description><addressOffset>0x0E04</addressOffset><size>16</size><access>read-write</access><resetValue>0x0000</resetValue></register>

    <register><name>DNFA15CTL</name><description>DNF group 15 (TAUA1I6/7) control register</description><addressOffset>0x0F00</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DNFA15EN</name><description>DNF group 15 enable register</description><addressOffset>0x0F04</addressOffset><size>16</size><access>read-write</access><resetValue>0x0000</resetValue></register>

    <register><name>DNFA16CTL</name><description>DNF group 16 (TAUA1I8/9) control register</description><addressOffset>0x1000</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DNFA16EN</name><description>DNF group 16 enable register</description><addressOffset>0x1004</addressOffset><size>16</size><access>read-write</access><resetValue>0x0000</resetValue></register>

    <register><name>DNFA17CTL</name><description>DNF group 17 (TAUA1I10/11) control register</description><addressOffset>0x1100</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DNFA17EN</name><description>DNF group 17 enable register</description><addressOffset>0x1104</addressOffset><size>16</size><access>read-write</access><resetValue>0x0000</resetValue></register>

    <register><name>DNFA18CTL</name><description>DNF group 18 (TAUA1I12/13) control register</description><addressOffset>0x1200</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DNFA18EN</name><description>DNF group 18 enable register</description><addressOffset>0x1204</addressOffset><size>16</size><access>read-write</access><resetValue>0x0000</resetValue></register>

    <register><name>DNFA19CTL</name><description>DNF group 19 (TAUA1I14/15) control register</description><addressOffset>0x1300</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DNFA19EN</name><description>DNF group 19 enable register</description><addressOffset>0x1304</addressOffset><size>16</size><access>read-write</access><resetValue>0x0000</resetValue></register>

    <!-- DNFA20..23: TAUJ0 -->
    <register><name>DNFA20CTL</name><description>DNF group 20 (TAUJ0I0) control register</description><addressOffset>0x1400</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DNFA20EN</name><description>DNF group 20 enable register</description><addressOffset>0x1404</addressOffset><size>16</size><access>read-write</access><resetValue>0x0000</resetValue></register>

    <register><name>DNFA21CTL</name><description>DNF group 21 (TAUJ0I1) control register</description><addressOffset>0x1500</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DNFA21EN</name><description>DNF group 21 enable register</description><addressOffset>0x1504</addressOffset><size>16</size><access>read-write</access><resetValue>0x0000</resetValue></register>

    <register><name>DNFA22CTL</name><description>DNF group 22 (TAUJ0I2) control register</description><addressOffset>0x1600</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DNFA22EN</name><description>DNF group 22 enable register</description><addressOffset>0x1604</addressOffset><size>16</size><access>read-write</access><resetValue>0x0000</resetValue></register>

    <register><name>DNFA23CTL</name><description>DNF group 23 (TAUJ0I3) control register</description><addressOffset>0x1700</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DNFA23EN</name><description>DNF group 23 enable register</description><addressOffset>0x1704</addressOffset><size>16</size><access>read-write</access><resetValue>0x0000</resetValue></register>

    <!-- DNFA24..27: TAUJ1 -->
    <register><name>DNFA24CTL</name><description>DNF group 24 (TAUJ1I0) control register</description><addressOffset>0x1800</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DNFA24EN</name><description>DNF group 24 enable register</description><addressOffset>0x1804</addressOffset><size>16</size><access>read-write</access><resetValue>0x0000</resetValue></register>

    <register><name>DNFA25CTL</name><description>DNF group 25 (TAUJ1I1) control register</description><addressOffset>0x1900</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DNFA25EN</name><description>DNF group 25 enable register</description><addressOffset>0x1904</addressOffset><size>16</size><access>read-write</access><resetValue>0x0000</resetValue></register>

    <register><name>DNFA26CTL</name><description>DNF group 26 (TAUJ1I2) control register</description><addressOffset>0x1A00</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DNFA26EN</name><description>DNF group 26 enable register</description><addressOffset>0x1A04</addressOffset><size>16</size><access>read-write</access><resetValue>0x0000</resetValue></register>

    <register><name>DNFA27CTL</name><description>DNF group 27 (TAUJ1I3) control register</description><addressOffset>0x1B00</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DNFA27EN</name><description>DNF group 27 enable register</description><addressOffset>0x1B04</addressOffset><size>16</size><access>read-write</access><resetValue>0x0000</resetValue></register>

    <!-- DNFA28..30: TSG20 / ENC0 -->
    <register><name>DNFA28CTL</name><description>DNF group 28 (TSG20PTSI0/1, ENCA0E0/1) control register</description><addressOffset>0x1C00</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DNFA28EN</name><description>DNF group 28 enable register</description><addressOffset>0x1C04</addressOffset><size>16</size><access>read-write</access><resetValue>0x0000</resetValue></register>

    <register><name>DNFA29CTL</name><description>DNF group 29 (TSG20PTSI2/ENCA0EC) control register</description><addressOffset>0x1D00</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DNFA29EN</name><description>DNF group 29 enable register</description><addressOffset>0x1D04</addressOffset><size>16</size><access>read-write</access><resetValue>0x0000</resetValue></register>

    <register><name>DNFA30CTL</name><description>DNF group 30 (TSG20CLKI) control register</description><addressOffset>0x1E00</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DNFA30EN</name><description>DNF group 30 enable register</description><addressOffset>0x1E04</addressOffset><size>16</size><access>read-write</access><resetValue>0x0000</resetValue></register>

    <!-- DNFA31..33: TSG21 / ENC1 -->
    <register><name>DNFA31CTL</name><description>DNF group 31 (TSG21PTSI0/1, ENCA1E0/1) control register</description><addressOffset>0x1F00</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DNFA31EN</name><description>DNF group 31 enable register</description><addressOffset>0x1F04</addressOffset><size>16</size><access>read-write</access><resetValue>0x0000</resetValue></register>

    <register><name>DNFA32CTL</name><description>DNF group 32 (TSG21PTSI2/ENCA1EC) control register</description><addressOffset>0x2000</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DNFA32EN</name><description>DNF group 32 enable register</description><addressOffset>0x2004</addressOffset><size>16</size><access>read-write</access><resetValue>0x0000</resetValue></register>

    <register><name>DNFA33CTL</name><description>DNF group 33 (TSG21CLKI) control register</description><addressOffset>0x2100</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DNFA33EN</name><description>DNF group 33 enable register</description><addressOffset>0x2104</addressOffset><size>16</size><access>read-write</access><resetValue>0x0000</resetValue></register>

    <!-- DNFA34..35: ENC0/ENC1 phase inputs -->
    <register><name>DNFA34CTL</name><description>DNF group 34 (ENCA0I0/1) control register</description><addressOffset>0x2200</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DNFA34EN</name><description>DNF group 34 enable register</description><addressOffset>0x2204</addressOffset><size>16</size><access>read-write</access><resetValue>0x0000</resetValue></register>

    <register><name>DNFA35CTL</name><description>DNF group 35 (ENCA1I0/1) control register</description><addressOffset>0x2300</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DNFA35EN</name><description>DNF group 35 enable register</description><addressOffset>0x2304</addressOffset><size>16</size><access>read-write</access><resetValue>0x0000</resetValue></register>

    <!-- DNFA36: CSI ready inputs -->
    <register><name>DNFA36CTL</name><description>DNF group 36 (CSIG0/1/2RYI, CSIH0/1RYI) control register</description><addressOffset>0x2400</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DNFA36EN</name><description>DNF group 36 enable register</description><addressOffset>0x2404</addressOffset><size>16</size><access>read-write</access><resetValue>0x0000</resetValue>
      <fields>
        <field><name>DNFA36NFEN4</name><description>CSIG2RYI noise cancellation enable</description><bitRange>[4:4]</bitRange></field>
        <field><name>DNFA36NFEN3</name><description>CSIG1RYI noise cancellation enable</description><bitRange>[3:3]</bitRange></field>
        <field><name>DNFA36NFEN2</name><description>CSIG0RYI noise cancellation enable</description><bitRange>[2:2]</bitRange></field>
        <field><name>DNFA36NFEN1</name><description>CSIH1RYI noise cancellation enable</description><bitRange>[1:1]</bitRange></field>
        <field><name>DNFA36NFEN0</name><description>CSIH0RYI noise cancellation enable</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>

  </registers>
</peripheral>

<!-- ============================================================ -->
<!-- DNFSCTL: Digital Noise Filter Sampling Clock Control          -->
<!-- Standalone at 0xFF420034 (outside DNFn_base range)          -->
<!-- ============================================================ -->
<peripheral>
  <name>DNFSCTL</name>
  <description>Digital noise filter sampling clock control register (Table 2-62)</description>
  <baseAddress>0xFF420034</baseAddress>
  <addressBlock><offset>0x0</offset><size>0x2</size><usage>registers</usage></addressBlock>
  <registers>

    <register>
      <name>DNFSCTL</name>
      <description>DNF sampling clock control register</description>
      <addressOffset>0x0</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field><name>DNFSCKSL71_70</name><description>TAUJ1 group sampling clock: 00=PCLK, 01=PCLK/2, 10=TAUJ1ch0 CKEN</description><bitRange>[15:14]</bitRange></field>
        <field><name>DNFSCKSL61_60</name><description>TAUJ0 group sampling clock: 00=PCLK, 01=PCLK/2, 10=TAUJ0ch0 CKEN</description><bitRange>[13:12]</bitRange></field>
        <field><name>DNFSCKSL51_50</name><description>TAUA1 group sampling clock</description><bitRange>[11:10]</bitRange></field>
        <field><name>DNFSCKSL41_40</name><description>TAUA0 group sampling clock</description><bitRange>[9:8]</bitRange></field>
        <field><name>DNFSCKSL20</name><description>CSI group sampling clock: 0=PCLK, 1=PCLK/2</description><bitRange>[4:4]</bitRange></field>
        <field><name>DNFSCKSL10</name><description>TSG2/ENC group sampling clock: 0=PCLK, 1=PCLK/2</description><bitRange>[2:2]</bitRange></field>
        <field><name>DNFSCKSL00</name><description>INTP group sampling clock: 0=PCLK, 1=PCLK/2</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>

  </registers>
</peripheral>

<!-- ============================================================ -->
<!-- FCLA0: Edge detection filter - NMI                          -->
<!-- baseAddress = 0xFF414000                                    -->
<!-- ============================================================ -->
<peripheral>
  <name>FCLA0</name>
  <description>Edge detection filter group 0 - NMI (Table 2-65)</description>
  <baseAddress>0xFF414000</baseAddress>
  <addressBlock><offset>0x0</offset><size>0x1</size><usage>registers</usage></addressBlock>
  <registers>

    <register>
      <name>FCLA0CTL0</name>
      <description>Edge detection filter control register for NMI</description>
      <addressOffset>0x0</addressOffset>
      <size>8</size>
      <access>read-write</access>
      <resetValue>0x00</resetValue>
      <fields>
        <field><name>FCLA0INTF0</name><description>Falling edge detection: 0=disabled, 1=enabled</description><bitRange>[1:1]</bitRange></field>
        <field><name>FCLA0INTR0</name><description>Rising edge detection: 0=disabled, 1=enabled</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>

  </registers>
</peripheral>

<!-- ============================================================ -->
<!-- FCLA1: Edge detection filter - INTP0..7                     -->
<!-- baseAddress = 0xFF414100                                    -->
<!-- ============================================================ -->
<peripheral>
  <name>FCLA1</name>
  <description>Edge detection filter group 1 - INTP0..7 (Table 2-65)</description>
  <baseAddress>0xFF414100</baseAddress>
  <addressBlock><offset>0x0</offset><size>0x1D</size><usage>registers</usage></addressBlock>
  <registers>

    <register>
      <name>FCLA1CTL0</name>
      <description>Edge detection filter control for INTP0</description>
      <addressOffset>0x00</addressOffset>
      <size>8</size>
      <access>read-write</access>
      <resetValue>0x00</resetValue>
      <fields>
