<!-- PORT3_CFG: has PIBC, PBDC, PIPC, PU, PODC, PPROTS, PPCMD -->
<peripheral>
  <name>PORT3_CFG</name>
  <description>Port 3 electrical configuration registers (includes PODC, PBDC)</description>
  <baseAddress>0xFF40400C</baseAddress>
  <addressBlock><offset>0x0</offset><size>0xC04</size><usage>registers</usage></addressBlock>
  <registers>

    <register>
      <name>PIBC3</name>
      <description>Port 3 input buffer control register</description>
      <addressOffset>0x0000</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
    </register>

    <register>
      <name>PBDC3</name>
      <description>Port 3 bi-direction control register</description>
      <addressOffset>0x0100</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
    </register>

    <register>
      <name>PIPC3</name>
      <description>Port 3 IP control register</description>
      <addressOffset>0x0200</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
    </register>

    <register>
      <name>PU3</name>
      <description>Port 3 pull-up option register</description>
      <addressOffset>0x0300</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
    </register>

    <register>
      <name>PODC3</name>
      <description>Port 3 open drain control register (protected write)</description>
      <addressOffset>0x0500</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
    </register>

    <register>
      <name>PPROTS3</name>
      <description>Port 3 protection status register</description>
      <addressOffset>0x0B00</addressOffset>
      <size>8</size>
      <access>read-only</access>
      <resetValue>0x00</resetValue>
      <fields>
        <field><name>PPROTSn_0</name><description>Protection error flag</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>

    <register>
      <name>PPCMD3</name>
      <description>Port 3 register protection command register</description>
      <addressOffset>0x0C00</addressOffset>
      <size>8</size>
      <access>write-only</access>
      <resetValue>0x00</resetValue>
    </register>

  </registers>
</peripheral>

