<!-- Section 2: Port Functions - V850E2/Px4 (UPD70F3508) -->
<!--
  Base addresses (Table 2-2):
    PORTn_base0 = 0xFF400000   (electrical-characteristics registers)
    PORTn_base1 = 0xFFFF8000   (data / mode registers)
    DNFn_base   = 0xFF410000   (digital noise-filter registers)
    JTAG port 0 fixed at       0xFF440000
    FCLA0 fixed at             0xFF414000
    FCLA1 fixed at             0xFF414100
    FCLA2 fixed at             0xFF414200
    DNFSCTL fixed at           0xFF420034

  Register address formulas (Table 2-7):
    Pn        = PORTn_base1 + n*4
    PSRn      = PORTn_base1 + 0x100 + n*4
    PPRn      = PORTn_base1 + 0x200 + n*4
    PMn       = PORTn_base1 + 0x300 + n*4
    PMCn      = PORTn_base1 + 0x400 + n*4   (n=0..7)
    PFCn      = PORTn_base1 + 0x500 + n*4   (n=0..7)
    PFCEn     = PORTn_base1 + 0x600 + n*4   (n=0..7)
    PNOTn     = PORTn_base1 + 0x700 + n*4
    PMSRn     = PORTn_base1 + 0x800 + n*4
    PMCSRn    = PORTn_base1 + 0x900 + n*4   (n=0..7)
    PIBCn     = PORTn_base0 + 0x4000 + n*4
    PBDCn     = PORTn_base0 + 0x4100 + n*4  (n=0,1,3,4,5,6)
    PIPCn     = PORTn_base0 + 0x4200 + n*4  (n=0..7)
    PUn       = PORTn_base0 + 0x4300 + n*4
    PODCn     = PORTn_base0 + 0x4500 + n*4  (n=2,3)
    PDSCn     = PORTn_base0 + 0x4600 + n*4  (n=6 only)
    PISn      = PORTn_base0 + 0x4700 + n*4  (n=6 only)
    PPROTSn   = PORTn_base0 + 0x4B00 + n*4  (n=2,3,6)
    PPCMDn    = PORTn_base0 + 0x4C00 + n*4  (n=2,3,6)

  Each port group is split into two SVD peripherals:
    PORT{n}_DATA  - data / mode registers (base1 region, baseAddress = Pn address)
    PORT{n}_CFG   - electrical config registers (base0 region, baseAddress = PIBCn address)

  Port 8 has NO alternative-function registers (PMC, PFC, PFCE, PIPC, PBDC, PODC, PDSC, PIS,
  PPCMD, PPROTS), only P, PSR, PPR, PM, PNOT, PMSR, PIBC, PU.

  DNF (digital noise filter) n=0..36:
    DNFAnCTL  = DNFn_base + n*0x100
    DNFAnEN   = DNFn_base + n*0x100 + 4
    DNFSCTL   = 0xFF420034

  FCLA (edge-detection filter) - absolute addresses (Table 2-65).
-->

<!-- ============================================================ -->
<!-- PORT0_DATA: Port 0 data / mode registers                     -->
<!-- baseAddress = P0 = 0xFFFF8000                               -->
<!-- ============================================================ -->
<peripheral>
  <name>PORT0_DATA</name>
  <description>Port 0 data and mode control registers</description>
  <baseAddress>0xFFFF8000</baseAddress>
  <addressBlock><offset>0x0</offset><size>0x904</size><usage>registers</usage></addressBlock>
  <registers>

    <register>
      <name>P0</name>
      <description>Port 0 register</description>
      <addressOffset>0x000</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field><name>P0_15_0</name><description>Port 0 output data bits [15:0]</description><bitRange>[15:0]</bitRange></field>
      </fields>
    </register>

    <register>
      <name>PSR0</name>
      <description>Port 0 set reset register</description>
      <addressOffset>0x100</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <fields>
        <field><name>PSR0_31_16</name><description>Mask bits: 1 = corresponding lower bit is written to P0</description><bitRange>[31:16]</bitRange></field>
        <field><name>PSR0_15_0</name><description>Value bits for P0 when corresponding mask bit is 1</description><bitRange>[15:0]</bitRange></field>
      </fields>
    </register>

    <register>
      <name>PPR0</name>
      <description>Port 0 pin read register</description>
      <addressOffset>0x200</addressOffset>
      <size>16</size>
      <access>read-only</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field><name>PPR0_15_0</name><description>Pin P0_m, P0.P0_m value, or alternative function output</description><bitRange>[15:0]</bitRange></field>
      </fields>
    </register>

    <register>
      <name>PM0</name>
      <description>Port 0 mode register (0=output, 1=input)</description>
      <addressOffset>0x300</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0xFFFF</resetValue>
      <fields>
        <field><name>PM0_15_0</name><description>I/O mode bits: 0=output, 1=input</description><bitRange>[15:0]</bitRange></field>
      </fields>
    </register>

    <register>
      <name>PMC0</name>
      <description>Port 0 mode control register (0=port mode, 1=alternative mode)</description>
      <addressOffset>0x400</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field><name>PMC0_15_0</name><description>Pin mode: 0=port mode, 1=alternative mode</description><bitRange>[15:0]</bitRange></field>
      </fields>
    </register>

    <register>
      <name>PFC0</name>
      <description>Port 0 function control register</description>
      <addressOffset>0x500</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field><name>PFC0_15_0</name><description>Alternative function select (with PFCE0)</description><bitRange>[15:0]</bitRange></field>
      </fields>
    </register>

    <register>
      <name>PFCE0</name>
      <description>Port 0 function control expansion register</description>
      <addressOffset>0x600</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field><name>PFCE0_15_0</name><description>Alternative function expansion select (with PFC0)</description><bitRange>[15:0]</bitRange></field>
      </fields>
    </register>

    <register>
      <name>PNOT0</name>
      <description>Port 0 NOT register (write 1 to invert corresponding P0 bit)</description>
      <addressOffset>0x700</addressOffset>
      <size>16</size>
      <access>write-only</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field><name>PNOT0_15_0</name><description>Write 1 to invert P0.P0_m</description><bitRange>[15:0]</bitRange></field>
      </fields>
    </register>

    <register>
      <name>PMSR0</name>
      <description>Port 0 mode set reset register</description>
      <addressOffset>0x800</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x0000FFFF</resetValue>
      <fields>
        <field><name>PMSR0_31_16</name><description>Mask bits: 1 = corresponding lower PM0 bit is written</description><bitRange>[31:16]</bitRange></field>
        <field><name>PMSR0_15_0</name><description>Value bits for PM0 when corresponding mask bit is 1</description><bitRange>[15:0]</bitRange></field>
      </fields>
    </register>

    <register>
      <name>PMCSR0</name>
      <description>Port 0 mode control set reset register</description>
      <addressOffset>0x900</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <fields>
        <field><name>PMCSR0_31_16</name><description>Mask bits: 1 = corresponding PMC0 bit is written</description><bitRange>[31:16]</bitRange></field>
        <field><name>PMCSR0_15_0</name><description>Value bits for PMC0 when corresponding mask bit is 1</description><bitRange>[15:0]</bitRange></field>
      </fields>
    </register>

  </registers>
</peripheral>

<!-- ============================================================ -->
<!-- PORT0_CFG: Port 0 electrical-characteristics registers       -->
<!-- baseAddress = PIBC0 = 0xFF404000                            -->
<!-- ============================================================ -->
<peripheral>
  <name>PORT0_CFG</name>
  <description>Port 0 electrical configuration registers</description>
  <baseAddress>0xFF404000</baseAddress>
  <addressBlock><offset>0x0</offset><size>0xC04</size><usage>registers</usage></addressBlock>
  <registers>

    <register>
      <name>PIBC0</name>
      <description>Port 0 input buffer control register</description>
      <addressOffset>0x0000</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field><name>PIBC0_15_0</name><description>Input buffer enable: 0=disabled, 1=enabled</description><bitRange>[15:0]</bitRange></field>
      </fields>
    </register>

    <register>
      <name>PBDC0</name>
      <description>Port 0 bi-direction control register</description>
      <addressOffset>0x0100</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field><name>PBDC0_15_0</name><description>Bi-directional mode: 0=disabled, 1=enabled (forces pin level readable)</description><bitRange>[15:0]</bitRange></field>
      </fields>
    </register>

    <register>
      <name>PIPC0</name>
      <description>Port 0 IP control register (I/O direction control)</description>
      <addressOffset>0x0200</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field><name>PIPC0_15_0</name><description>I/O control: 0=software (PM), 1=peripheral (direct)</description><bitRange>[15:0]</bitRange></field>
      </fields>
    </register>

    <register>
      <name>PU0</name>
      <description>Port 0 pull-up option register</description>
      <addressOffset>0x0300</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field><name>PU0_15_0</name><description>Pull-up resistor: 0=disconnected, 1=connected</description><bitRange>[15:0]</bitRange></field>
      </fields>
    </register>

  </registers>
</peripheral>

<!-- ============================================================ -->
