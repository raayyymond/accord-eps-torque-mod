<!-- PORT2_CFG: Port 2 has PIBC, PIPC, PU, PODC, PPROTS, PPCMD (no PBDC per description "n=0,1,3-6") -->
<peripheral>
  <name>PORT2_CFG</name>
  <description>Port 2 electrical configuration registers (includes PODC open-drain control)</description>
  <baseAddress>0xFF404008</baseAddress>
  <addressBlock><offset>0x0</offset><size>0xC04</size><usage>registers</usage></addressBlock>
  <registers>

    <register>
      <name>PIBC2</name>
      <description>Port 2 input buffer control register</description>
      <addressOffset>0x0000</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
    </register>

    <!-- PBDC2 not present (PBDCn valid for n=0,1,3..6 only) -->

    <register>
      <name>PIPC2</name>
      <description>Port 2 IP control register</description>
      <addressOffset>0x0200</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
    </register>

    <register>
      <name>PU2</name>
      <description>Port 2 pull-up option register</description>
      <addressOffset>0x0300</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
    </register>

    <register>
      <name>PODC2</name>
      <description>Port 2 open drain control register (protected write)</description>
      <addressOffset>0x0500</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <fields>
        <field><name>PODC2_31_0</name><description>Output buffer: 0=push-pull, 1=open-drain</description><bitRange>[31:0]</bitRange></field>
      </fields>
    </register>

    <register>
      <name>PPROTS2</name>
      <description>Port 2 protection status register</description>
      <addressOffset>0x0B00</addressOffset>
      <size>8</size>
      <access>read-only</access>
      <resetValue>0x00</resetValue>
      <fields>
        <field><name>PPROTSn_0</name><description>Protection error: 0=none, 1=write-sequence error</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>

    <register>
      <name>PPCMD2</name>
      <description>Port 2 register protection command register</description>
      <addressOffset>0x0C00</addressOffset>
      <size>8</size>
      <access>write-only</access>
      <resetValue>0x00</resetValue>
    </register>

  </registers>
</peripheral>

