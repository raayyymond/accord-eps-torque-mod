<!-- PORT6_CFG: has PIBC, PBDC, PIPC, PU, PDSC, PIS, PPROTS, PPCMD -->
<peripheral>
  <name>PORT6_CFG</name>
  <description>Port 6 electrical configuration registers (includes PDSC drive-strength, PIS input-select)</description>
  <baseAddress>0xFF404018</baseAddress>
  <addressBlock><offset>0x0</offset><size>0xC04</size><usage>registers</usage></addressBlock>
  <registers>

    <register>
      <name>PIBC6</name>
      <description>Port 6 input buffer control register</description>
      <addressOffset>0x0000</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
    </register>

    <register>
      <name>PBDC6</name>
      <description>Port 6 bi-direction control register</description>
      <addressOffset>0x0100</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
    </register>

    <register>
      <name>PIPC6</name>
      <description>Port 6 IP control register</description>
      <addressOffset>0x0200</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
    </register>

    <register>
      <name>PU6</name>
      <description>Port 6 pull-up option register</description>
      <addressOffset>0x0300</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
    </register>

    <register>
      <name>PDSC6</name>
      <description>Port 6 drive strength control register (protected write; 0=25MHz, 1=40MHz per bit)</description>
      <addressOffset>0x0600</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <fields>
        <field><name>PDSC6_31_0</name><description>Drive strength per bit: 0=low (25 MHz), 1=high (40 MHz)</description><bitRange>[31:0]</bitRange></field>
      </fields>
    </register>

    <register>
      <name>PIS6</name>
      <description>Port 6 input buffer selection register (0=Schmitt, 1=CMOS characteristics)</description>
      <addressOffset>0x0700</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field><name>PIS6_15_0</name><description>Input buffer type: 0=Schmitt trigger, 1=CMOS</description><bitRange>[15:0]</bitRange></field>
      </fields>
    </register>

    <register>
      <name>PPROTS6</name>
      <description>Port 6 protection status register</description>
      <addressOffset>0x0B00</addressOffset>
      <size>8</size>
      <access>read-only</access>
      <resetValue>0x00</resetValue>
      <fields>
        <field><name>PPROTSn_0</name><description>Protection error flag</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>

    <register>
      <name>PPCMD6</name>
      <description>Port 6 register protection command register</description>
      <addressOffset>0x0C00</addressOffset>
      <size>8</size>
      <access>write-only</access>
      <resetValue>0x00</resetValue>
    </register>

  </registers>
</peripheral>

