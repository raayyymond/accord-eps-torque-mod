<!-- ================================================================ -->
<!-- PPU: CPU Core Protection Peripheral Violation Registers (Table 9-30, 9.7.2) -->
<!-- Base: 0xFFFF5110 (lowest address VPNECR)                          -->
<!-- NOTE: Multiple byte-alias names map to the same 32-bit address.   -->
<!-- Only the word-width canonical name is emitted per unique address.  -->
<!-- ================================================================ -->
<peripheral>
  <name>PPU</name>
  <description>CPU Core Protection Peripheral Protection Unit violation registers (Table 9-30)</description>
  <baseAddress>0xFFFF5110</baseAddress>
  <addressBlock><offset>0x0</offset><size>0x1C</size><usage>registers</usage></addressBlock>
  <registers>

    <!-- NT-state (Non-Task-state) violation registers -->
    <register>
      <name>VPNECR</name>
      <description>Peripheral device protection NT state violation cause register (32-bit canonical; byte aliases VPNECRL/VPNECRLL/VPNECRLH also map here)</description>
      <addressOffset>0x0</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <!-- Initial value: Undefined; no resetValue emitted -->
    </register>

    <register>
      <name>VPNADR</name>
      <description>Peripheral device protection NT state violation address register (32-bit canonical; byte/halfword aliases also map here)</description>
      <addressOffset>0x4</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <!-- Initial value: Undefined; no resetValue emitted -->
    </register>

    <register>
      <name>VPNTID</name>
      <description>Peripheral device protection NT state violation task ID register (32-bit canonical; byte/halfword aliases also map here)</description>
      <addressOffset>0x8</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <!-- Initial value: Undefined; no resetValue emitted -->
    </register>

    <!-- T-state (Task-state) violation registers -->
    <!-- 0xFFFF5120 = base + 0x10 -->
    <register>
      <name>VPTECR</name>
      <description>Peripheral device protection T state violation cause register (32-bit canonical; byte aliases also map here)</description>
      <addressOffset>0x10</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <!-- Initial value: Undefined; no resetValue emitted -->
    </register>

    <!-- 0xFFFF5124 = base + 0x14 -->
    <register>
      <name>VPTADR</name>
      <description>Peripheral device protection T state violation address register (32-bit canonical; byte/halfword aliases also map here)</description>
      <addressOffset>0x14</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <!-- Initial value: Undefined; no resetValue emitted -->
    </register>

    <!-- 0xFFFF5128 = base + 0x18 -->
    <register>
      <name>VPTTID</name>
      <description>Peripheral device protection T state violation task ID register (32-bit canonical; byte/halfword aliases also map here)</description>
      <addressOffset>0x18</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <!-- Initial value: Undefined; no resetValue emitted -->
    </register>

  </registers>
</peripheral>

<!-- ================================================================ -->
<!-- TSC: Timing Supervision Counter Registers (Table 9-31, 9.7.2)    -->
<!-- Base: 0xFFFF5024 (lowest address TSCCNT0)                         -->
<!-- 6 counter channels; each channel has CNT/CMP/RLD at +0x10 stride -->
<!-- ================================================================ -->
<peripheral>
  <name>TSC</name>
  <description>Timing Supervision Counter registers — count, compare, and reload values for channels 0-5 (Table 9-31)</description>
  <baseAddress>0xFFFF5024</baseAddress>
