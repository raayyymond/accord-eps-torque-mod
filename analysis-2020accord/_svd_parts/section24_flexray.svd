<!-- Section 24 FlexRay (FLX) - V850E2/Px4 UPD70F3508 -->
<!-- FLX0 base: 0xFF580000 (Table 24-2) -->
<!-- ECC_FLX base: 0xFF464000 (E7A0CTL..E7A6CTL) -->

<peripheral>
  <name>FLX0</name>
  <description>FlexRay controller 0 (E-Ray)</description>
  <baseAddress>0xFF580000</baseAddress>
  <addressBlock>
    <offset>0x0</offset>
    <size>0x0718</size>
    <usage>registers</usage>
  </addressBlock>
  <registers>
        <register>
          <name>FLX0CI</name>
          <description>Controller information</description>
          <addressOffset>0x0000</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x65726179</resetValue>
          <fields>
            <field>
              <name>FLX0MN</name>
              <description>Controller information (ASCII eray)</description>
              <bitRange>[31:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>FLX0VI</name>
          <description>Vendor information</description>
