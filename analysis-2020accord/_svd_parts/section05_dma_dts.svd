    <!-- DTSHENm (m=0..3): DTS Hold Enable Registers -->
    <!-- Addresses: DTSHEN0=0xFFFF7E00, DTSHEN1=0xFFFF7E02, DTSHEN2=0xFFFF7E04, DTSHEN3=0xFFFF7E06 -->
    <!-- Offsets from DTSFSL base (0xFFFF7D00): 0x100, 0x102, 0x104, 0x106 -->
    <register>
      <name>DTSHEN0</name>
      <description>DTS Hold Enable Register 0</description>
      <addressOffset>0x100</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field><name>HEN</name><description>Hold-enable register operation enable</description><bitRange>[15:15]</bitRange></field>
        <field><name>dtsch6_0</name><description>Target channel for holding [6:0]</description><bitRange>[6:0]</bitRange></field>
      </fields>
    </register>
    <register>
      <name>DTSHEN1</name>
      <description>DTS Hold Enable Register 1</description>
      <addressOffset>0x102</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field><name>HEN</name><description>Hold-enable register operation enable</description><bitRange>[15:15]</bitRange></field>
        <field><name>dtsch6_0</name><description>Target channel for holding [6:0]</description><bitRange>[6:0]</bitRange></field>
      </fields>
    </register>
    <register>
      <name>DTSHEN2</name>
      <description>DTS Hold Enable Register 2</description>
      <addressOffset>0x104</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field><name>HEN</name><description>Hold-enable register operation enable</description><bitRange>[15:15]</bitRange></field>
        <field><name>dtsch6_0</name><description>Target channel for holding [6:0]</description><bitRange>[6:0]</bitRange></field>
      </fields>
    </register>
    <register>
      <name>DTSHEN3</name>
