<!-- Section 5: DMA/DTS Module — V850E2/Px4 (UPD70F3508) -->
<!-- Extracted from PDF pages 243-360. -->
<!-- Two peripherals: DMAC (0xFFFF7300), DTFR (0xFFFF7B00). -->
<!-- Three more: DTS (0xFFFF7C00), DTSFSL (0xFFFF7D00), DTSHEN (0xFFFF7E00). -->
<!-- DTSSEL registers: base address is printed as <DTSSEL_base> in the manual — UNRESOLVED, not emitted. -->

<!-- ================================================================ -->
<!-- DMAC: DMA Controller registers (DTRC0 + 8-channel per-ch regs)   -->
<!-- PDF Table 5-5, Section 5.5.x detail registers                    -->
<!-- ================================================================ -->
<peripheral>
  <name>DMAC</name>
  <description>DMA Controller — 8-channel DMAC register block</description>
  <baseAddress>0xFFFF7300</baseAddress>
  <addressBlock><offset>0x0</offset><size>0x18C</size><usage>registers</usage></addressBlock>
  <registers>

    <!-- 5.5.1 DTRC0 — DMA Transfer Request Control Register 0 -->
    <register>
      <name>DTRC0</name>
      <description>DMA Transfer Request Control Register 0</description>
      <addressOffset>0x0</addressOffset>
      <size>8</size>
      <access>read-write</access>
      <resetValue>0x00</resetValue>
      <fields>
        <field><name>DTRC0ERR</name><description>DMA transfer error status; write 0 to clear</description><bitRange>[7:7]</bitRange></field>
        <field><name>DTRC0ADS</name><description>DMA transfer suspended; write 1 to request suspend</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>

    <!-- CH0 registers (base offset 0x10 from DTRC0) -->
    <register>
      <name>DTRS0</name>
      <description>DMA Transfer Request Select Register CH0</description>
      <addressOffset>0x10</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field><name>DTRS0DTR3</name><description>DMA transfer request assignment bit 3</description><bitRange>[3:3]</bitRange></field>
        <field><name>DTRS0DTR2</name><description>DMA transfer request assignment bit 2</description><bitRange>[2:2]</bitRange></field>
        <field><name>DTRS0DTR1</name><description>DMA transfer request assignment bit 1</description><bitRange>[1:1]</bitRange></field>
        <field><name>DTRS0DTR0</name><description>DMA transfer request assignment bit 0</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>
    <register>
      <name>DSA0L</name>
      <description>DMA Source Address Register L CH0</description>
      <addressOffset>0x14</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
    </register>
    <register>
      <name>DSA0H</name>
      <description>DMA Source Address Register H CH0</description>
      <addressOffset>0x16</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
    </register>
    <register>
      <name>DSC0</name>
      <description>DMA Source Chip Select Register CH0</description>
      <addressOffset>0x18</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0001</resetValue>
      <fields>
        <field><name>DSC0SCS1</name><description>Source chip select bit 1</description><bitRange>[2:2]</bitRange></field>
        <field><name>DSC0SCS0</name><description>Source chip select bit 0</description><bitRange>[1:1]</bitRange></field>
        <field><name>DSC0SCSE</name><description>Source chip select enable</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>
    <register>
      <name>DNSA0L</name>
      <description>DMA Next Source Address Register L CH0</description>
      <addressOffset>0x1C</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
    </register>
    <register>
      <name>DNSA0H</name>
      <description>DMA Next Source Address Register H CH0</description>
      <addressOffset>0x1E</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field><name>DNSA0NSAV</name><description>Next source address valid; copy on transfer completion</description><bitRange>[15:15]</bitRange></field>
        <field><name>DNSA0NSA28_16</name><description>Next source address bits 28:16</description><bitRange>[12:0]</bitRange></field>
      </fields>
    </register>
    <register>
      <name>DNSC0</name>
      <description>DMA Next Source Chip Select Register CH0</description>
      <addressOffset>0x20</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0001</resetValue>
      <fields>
        <field><name>DNSC0NSCV</name><description>Next source chip select valid</description><bitRange>[15:15]</bitRange></field>
        <field><name>DNSC0NSCS1</name><description>Next source chip select bit 1</description><bitRange>[2:2]</bitRange></field>
        <field><name>DNSC0NSCS0</name><description>Next source chip select bit 0</description><bitRange>[1:1]</bitRange></field>
        <field><name>DNSC0NSCSE</name><description>Next source chip select enable</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>
    <register>
      <name>DDA0L</name>
      <description>DMA Destination Address Register L CH0</description>
      <addressOffset>0x24</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
    </register>
    <register>
      <name>DDA0H</name>
      <description>DMA Destination Address Register H CH0</description>
      <addressOffset>0x26</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
    </register>
    <register>
      <name>DDC0</name>
      <description>DMA Destination Chip Select Register CH0</description>
      <addressOffset>0x28</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0001</resetValue>
      <fields>
        <field><name>DDC0DCS1</name><description>Destination chip select bit 1</description><bitRange>[2:2]</bitRange></field>
        <field><name>DDC0DCS0</name><description>Destination chip select bit 0</description><bitRange>[1:1]</bitRange></field>
        <field><name>DDC0DCSE</name><description>Destination chip select enable</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>
    <register>
      <name>DNDA0L</name>
      <description>DMA Next Destination Address Register L CH0</description>
      <addressOffset>0x2C</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
    </register>
    <register>
      <name>DNDA0H</name>
      <description>DMA Next Destination Address Register H CH0</description>
      <addressOffset>0x2E</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field><name>DNDA0NDAV</name><description>Next destination address valid; copy on transfer completion</description><bitRange>[15:15]</bitRange></field>
        <field><name>DNDA0NDA28_16</name><description>Next destination address bits 28:16</description><bitRange>[12:0]</bitRange></field>
      </fields>
    </register>
    <register>
      <name>DNDC0</name>
      <description>DMA Next Destination Chip Select Register CH0</description>
      <addressOffset>0x30</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0001</resetValue>
      <fields>
        <field><name>DNDC0NDCV</name><description>Next destination chip select valid</description><bitRange>[15:15]</bitRange></field>
        <field><name>DNDC0NDCS1</name><description>Next destination chip select bit 1</description><bitRange>[2:2]</bitRange></field>
        <field><name>DNDC0NDCS0</name><description>Next destination chip select bit 0</description><bitRange>[1:1]</bitRange></field>
        <field><name>DNDC0NDCSE</name><description>Next destination chip select enable</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>
    <register>
      <name>DTC0</name>
      <description>DMA Transfer Count Register CH0</description>
      <addressOffset>0x32</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field><name>DTC0DTC14_0</name><description>DMA transfer count [14:0]; 0000H = 32768 transfers</description><bitRange>[14:0]</bitRange></field>
      </fields>
    </register>
    <register>
      <name>DNTC0</name>
      <description>DMA Next Transfer Count Register CH0</description>
      <addressOffset>0x34</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field><name>DNTC0NTCV</name><description>Next transfer count valid</description><bitRange>[15:15]</bitRange></field>
        <field><name>DNTC0NDTC14_0</name><description>DMA next transfer count [14:0]</description><bitRange>[14:0]</bitRange></field>
      </fields>
    </register>
    <register>
      <name>DTCC0</name>
      <description>DMA Transfer Count Compare Register CH0</description>
      <addressOffset>0x36</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field><name>DTCC0DTCC14_0</name><description>Transfer count comparison value [14:0]; 0 = no compare</description><bitRange>[14:0]</bitRange></field>
      </fields>
    </register>
    <register>
      <name>DTCT0</name>
      <description>DMA Transfer Control Register CH0</description>
      <addressOffset>0x38</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field><name>DTCT0DS1</name><description>Transfer data size bit 1</description><bitRange>[14:14]</bitRange></field>
        <field><name>DTCT0DS0</name><description>Transfer data size bit 0</description><bitRange>[13:13]</bitRange></field>
        <field><name>DTCT0MLE</name><description>Multi-link enable; 1 = do not clear DTSnDTE on completion</description><bitRange>[12:12]</bitRange></field>
        <field><name>DTCT0SACM1</name><description>Source address count direction bit 1</description><bitRange>[7:7]</bitRange></field>
        <field><name>DTCT0SACM0</name><description>Source address count direction bit 0</description><bitRange>[6:6]</bitRange></field>
        <field><name>DTCT0DACM1</name><description>Destination address count direction bit 1</description><bitRange>[5:5]</bitRange></field>
        <field><name>DTCT0DACM0</name><description>Destination address count direction bit 0</description><bitRange>[4:4]</bitRange></field>
      </fields>
    </register>
    <register>
      <name>DTS0</name>
      <description>DMA Transfer Status Register CH0</description>
      <addressOffset>0x3A</addressOffset>
      <size>8</size>
      <access>read-write</access>
      <resetValue>0x00</resetValue>
      <fields>
        <field><name>DTS0TC</name><description>DMA transfer end status; write 0 to clear</description><bitRange>[7:7]</bitRange></field>
        <field><name>DTS0DT</name><description>DMA transfer in progress</description><bitRange>[6:6]</bitRange></field>
        <field><name>DTS0ER</name><description>DMA transfer error flag (read-only)</description><bitRange>[3:3]</bitRange></field>
        <field><name>DTS0DR</name><description>Hardware DMA transfer request flag (read-only)</description><bitRange>[2:2]</bitRange></field>
        <field><name>DTS0SR</name><description>Software DMA transfer request; write 1 to request</description><bitRange>[1:1]</bitRange></field>
        <field><name>DTS0DTE</name><description>DMA transfer enable</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>

