<!-- ================================================================ -->
<!-- DTFR: DMA Trigger Factor Register block + DRQCLR + DRQSTR       -->
<!-- Section 5.8.x — base 0xFFFF7B00                                  -->
<!-- ================================================================ -->
<peripheral>
  <name>DTFR</name>
  <description>DMA Trigger Factor Registers and DMA Request Control</description>
  <baseAddress>0xFFFF7B00</baseAddress>
  <addressBlock><offset>0x0</offset><size>0x46</size><usage>registers</usage></addressBlock>
  <registers>

    <!-- 5.8.1 DTFRn (n=0..7): DMA Trigger Factor Register -->
    <register>
      <name>DTFR0</name>
      <description>DMA Trigger Factor Register CH0</description>
      <addressOffset>0x00</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field><name>DTFR0REQEN</name><description>DMA activating source selector enable</description><bitRange>[15:15]</bitRange></field>
        <field><name>IFC0_6_0</name><description>Transfer source select [6:0] (see Table 5-1)</description><bitRange>[6:0]</bitRange></field>
      </fields>
    </register>
    <register>
      <name>DTFR1</name>
      <description>DMA Trigger Factor Register CH1</description>
      <addressOffset>0x02</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field><name>DTFR1REQEN</name><description>DMA activating source selector enable</description><bitRange>[15:15]</bitRange></field>
        <field><name>IFC1_6_0</name><description>Transfer source select [6:0]</description><bitRange>[6:0]</bitRange></field>
      </fields>
    </register>
    <register>
      <name>DTFR2</name>
      <description>DMA Trigger Factor Register CH2</description>
      <addressOffset>0x04</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field><name>DTFR2REQEN</name><description>DMA activating source selector enable</description><bitRange>[15:15]</bitRange></field>
        <field><name>IFC2_6_0</name><description>Transfer source select [6:0]</description><bitRange>[6:0]</bitRange></field>
      </fields>
    </register>
    <register>
      <name>DTFR3</name>
      <description>DMA Trigger Factor Register CH3</description>
      <addressOffset>0x06</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field><name>DTFR3REQEN</name><description>DMA activating source selector enable</description><bitRange>[15:15]</bitRange></field>
        <field><name>IFC3_6_0</name><description>Transfer source select [6:0]</description><bitRange>[6:0]</bitRange></field>
      </fields>
    </register>
    <register>
      <name>DTFR4</name>
      <description>DMA Trigger Factor Register CH4</description>
      <addressOffset>0x08</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field><name>DTFR4REQEN</name><description>DMA activating source selector enable</description><bitRange>[15:15]</bitRange></field>
        <field><name>IFC4_6_0</name><description>Transfer source select [6:0]</description><bitRange>[6:0]</bitRange></field>
      </fields>
    </register>
    <register>
      <name>DTFR5</name>
      <description>DMA Trigger Factor Register CH5</description>
      <addressOffset>0x0A</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field><name>DTFR5REQEN</name><description>DMA activating source selector enable</description><bitRange>[15:15]</bitRange></field>
        <field><name>IFC5_6_0</name><description>Transfer source select [6:0]</description><bitRange>[6:0]</bitRange></field>
      </fields>
    </register>
    <register>
      <name>DTFR6</name>
      <description>DMA Trigger Factor Register CH6</description>
      <addressOffset>0x0C</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field><name>DTFR6REQEN</name><description>DMA activating source selector enable</description><bitRange>[15:15]</bitRange></field>
        <field><name>IFC6_6_0</name><description>Transfer source select [6:0]</description><bitRange>[6:0]</bitRange></field>
      </fields>
    </register>
    <register>
      <name>DTFR7</name>
      <description>DMA Trigger Factor Register CH7</description>
      <addressOffset>0x0E</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field><name>DTFR7REQEN</name><description>DMA activating source selector enable</description><bitRange>[15:15]</bitRange></field>
        <field><name>IFC7_6_0</name><description>Transfer source select [6:0]</description><bitRange>[6:0]</bitRange></field>
      </fields>
    </register>

    <!-- 5.8.2 DRQCLR: DMA Request Clear Register — 0xFFFF7B40 -->
    <register>
      <name>DRQCLR</name>
      <description>DMA Request Clear Register</description>
      <addressOffset>0x40</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field><name>RQCR7</name><description>Clear DMA request for CH7</description><bitRange>[7:7]</bitRange></field>
        <field><name>RQCR6</name><description>Clear DMA request for CH6</description><bitRange>[6:6]</bitRange></field>
        <field><name>RQCR5</name><description>Clear DMA request for CH5</description><bitRange>[5:5]</bitRange></field>
        <field><name>RQCR4</name><description>Clear DMA request for CH4</description><bitRange>[4:4]</bitRange></field>
        <field><name>RQCR3</name><description>Clear DMA request for CH3</description><bitRange>[3:3]</bitRange></field>
        <field><name>RQCR2</name><description>Clear DMA request for CH2</description><bitRange>[2:2]</bitRange></field>
        <field><name>RQCR1</name><description>Clear DMA request for CH1</description><bitRange>[1:1]</bitRange></field>
        <field><name>RQCR0</name><description>Clear DMA request for CH0</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>

    <!-- 5.8.3 DRQSTR: DMA Request Check Register — 0xFFFF7B44 -->
    <register>
      <name>DRQSTR</name>
      <description>DMA Request Check Register</description>
      <addressOffset>0x44</addressOffset>
      <size>16</size>
      <access>read-only</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field><name>RQST7</name><description>DMA transfer request pending CH7</description><bitRange>[7:7]</bitRange></field>
        <field><name>RQST6</name><description>DMA transfer request pending CH6</description><bitRange>[6:6]</bitRange></field>
        <field><name>RQST5</name><description>DMA transfer request pending CH5</description><bitRange>[5:5]</bitRange></field>
        <field><name>RQST4</name><description>DMA transfer request pending CH4</description><bitRange>[4:4]</bitRange></field>
        <field><name>RQST3</name><description>DMA transfer request pending CH3</description><bitRange>[3:3]</bitRange></field>
        <field><name>RQST2</name><description>DMA transfer request pending CH2</description><bitRange>[2:2]</bitRange></field>
        <field><name>RQST1</name><description>DMA transfer request pending CH1</description><bitRange>[1:1]</bitRange></field>
        <field><name>RQST0</name><description>DMA transfer request pending CH0</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>

  </registers>
</peripheral>

<!-- ================================================================ -->
<!-- DTS: Data Transfer Service control registers (Group A only)      -->
<!-- Section 5.10.x — base 0xFFFF7C00                                 -->
<!-- Group B registers (DTS0SAR, DTS0DAR, DTS0TCEA, etc.) are         -->
<!-- CPU-inaccessible internal registers — NOT emitted.               -->
<!-- ================================================================ -->
<peripheral>
  <name>DTS</name>
  <description>Data Transfer Service Control Registers (CPU-accessible Group A)</description>
  <baseAddress>0xFFFF7C00</baseAddress>
  <addressBlock><offset>0x0</offset><size>0x24</size><usage>registers</usage></addressBlock>
  <registers>

    <!-- 5.10.1 DTS0TSR: DTS Transfer Status Register -->
    <register>
      <name>DTS0TSR</name>
      <description>DTS Transfer Status Register</description>
      <addressOffset>0x00</addressOffset>
      <size>8</size>
      <access>read-only</access>
      <resetValue>0x00</resetValue>
      <fields>
        <field><name>DTS0STPE</name><description>DTS stopped by error response</description><bitRange>[1:1]</bitRange></field>
        <field><name>DTS0STPU</name><description>DTS stopped by user request</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>

    <!-- 5.10.2 DTS0TRC: DTS Transfer Request Control Register -->
    <register>
      <name>DTS0TRC</name>
      <description>DTS Transfer Request Control Register</description>
      <addressOffset>0x04</addressOffset>
      <size>8</size>
      <access>read-write</access>
      <resetValue>0x00</resetValue>
      <fields>
        <field><name>DTS0UST</name><description>DTS user stop trigger; write 1 to suspend all DTS</description><bitRange>[7:7]</bitRange></field>
        <field><name>DTS0ECL</name><description>DTS0STPE clearing trigger; write 1 to clear error stop</description><bitRange>[1:1]</bitRange></field>
        <field><name>DTS0UCL</name><description>DTS0STPU clearing trigger; write 1 to clear user stop</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>

    <!-- 5.10.3 DTS0ICR: DTS Initialization Control Register (16-bit at 0xFFFF7C08) -->
    <!-- DTS0ICH (lower byte) at 0xFFFF7C08, DTS0ITR (upper byte) at 0xFFFF7C09 -->
    <register>
      <name>DTS0ICR</name>
      <description>DTS Initialization Control Register (16-bit; lower byte=DTS0ICH, upper byte=DTS0ITR)</description>
      <addressOffset>0x08</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field><name>DTS0ICS</name><description>DTS initialization channel select status</description><bitRange>[10:10]</bitRange></field>
        <field><name>DTS0HIT</name><description>DTS TI hold init trigger; write 1 to trigger</description><bitRange>[9:9]</bitRange></field>
        <field><name>DTS0TIT</name><description>DTS TI init trigger; write 1 to trigger</description><bitRange>[8:8]</bitRange></field>
        <field><name>DTS0ICH6_0</name><description>DTS initialization channel number [6:0]</description><bitRange>[6:0]</bitRange></field>
      </fields>
    </register>

    <!-- 5.10.4 DTS0BTR: DTS Base Table Register -->
    <register>
      <name>DTS0BTR</name>
      <description>DTS Base Table Register — start address of DTS channel table in on-chip RAM</description>
      <addressOffset>0x0C</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <fields>
        <field><name>DTS0BTR28_1</name><description>Table base address bits [28:1]; bits 31:29 and 0 are fixed 0</description><bitRange>[28:1]</bitRange></field>
      </fields>
    </register>

    <!-- 5.10.5 DTS0BVR: DTS Base Vector Register -->
    <register>
      <name>DTS0BVR</name>
      <description>DTS Base Vector Register — start address of DTS vector table in on-chip RAM</description>
      <addressOffset>0x10</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <fields>
        <field><name>DTS0BVR28_2</name><description>Vector base address bits [28:2]; bits 31:29, 1, 0 fixed 0</description><bitRange>[28:2]</bitRange></field>
      </fields>
    </register>

    <!-- 5.10.6 DTS0ACR: DTS Active Channel Register -->
    <register>
      <name>DTS0ACR</name>
      <description>DTS Active Channel Register</description>
      <addressOffset>0x14</addressOffset>
      <size>16</size>
      <access>read-only</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field><name>DTS0ACT</name><description>DTS active; 1 = DTS is executing</description><bitRange>[8:8]</bitRange></field>
        <field><name>DTS0CH6_0</name><description>Active channel number [6:0]</description><bitRange>[6:0]</bitRange></field>
      </fields>
    </register>

    <!-- 5.10.7 DTS0HST: DTS TI Hold Status Register -->
    <register>
      <name>DTS0HST</name>
      <description>DTS TI Hold Status Register</description>
      <addressOffset>0x18</addressOffset>
      <size>8</size>
      <access>read-only</access>
      <resetValue>0x00</resetValue>
      <fields>
        <field><name>DTS0TON3</name><description>TI hold buffer 3 occupied</description><bitRange>[3:3]</bitRange></field>
        <field><name>DTS0TON2</name><description>TI hold buffer 2 occupied</description><bitRange>[2:2]</bitRange></field>
        <field><name>DTS0TON1</name><description>TI hold buffer 1 occupied</description><bitRange>[1:1]</bitRange></field>
        <field><name>DTS0TON0</name><description>TI hold buffer 0 occupied</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>

    <!-- 5.10.8 DTS0HC: DTS TI Hold Channel Number Register (32-bit) -->
    <!-- Also aliased as DTS0HC0..DTS0HC3 at bytes 0xFFFF7C20..0xFFFF7C23 -->
    <register>
      <name>DTS0HC</name>
      <description>DTS TI Hold Channel Number Register (32-bit; bytes 0..3 = HC0..HC3)</description>
      <addressOffset>0x20</addressOffset>
      <size>32</size>
      <access>read-only</access>
      <resetValue>0x00000000</resetValue>
      <fields>
        <field><name>DTS0HC3_CH6_0</name><description>Hold buffer 3 channel number [6:0] (bits [30:24])</description><bitRange>[30:24]</bitRange></field>
        <field><name>DTS0HC2_CH6_0</name><description>Hold buffer 2 channel number [6:0] (bits [22:16])</description><bitRange>[22:16]</bitRange></field>
        <field><name>DTS0HC1_CH6_0</name><description>Hold buffer 1 channel number [6:0] (bits [14:8])</description><bitRange>[14:8]</bitRange></field>
        <field><name>DTS0HC0_CH6_0</name><description>Hold buffer 0 channel number [6:0] (bits [6:0])</description><bitRange>[6:0]</bitRange></field>
      </fields>
    </register>

  </registers>
</peripheral>

<!-- ================================================================ -->
<!-- DTSFSL: DTS Factor Selector — DTSENn + DTSHENm                   -->
<!-- Section 5.13 — DTSENn base 0xFFFF7D00, DTSHENm base 0xFFFF7E00  -->
<!-- DTSENn: n=0..111, address = 0xFFFF7D00 + 2*n                     -->
<!-- Only DTSEN0..DTSEN7 emitted here (representative); full 112       -->
<!-- registers would need auto-generation. Entries 8..111 are          -->
<!-- structurally identical — skipped with note below.                 -->
<!-- ================================================================ -->
<peripheral>
  <name>DTSFSL</name>
  <description>DTS Factor Selector — DTSENn transfer enable registers (n=0..111) and DTSHENm hold enable registers (m=0..3)</description>
  <baseAddress>0xFFFF7D00</baseAddress>
  <addressBlock><offset>0x0</offset><size>0x108</size><usage>registers</usage></addressBlock>
  <registers>

    <!-- DTSENn (n=0..111): DTS Transfer Enable Registers -->
    <!-- Address = 0xFFFF7D00 + 2*n -->
    <!-- Emitting n=0..111 (all 112 channels) -->
    <register>
      <name>DTSEN0</name>
      <description>DTS Transfer Enable Register channel 0</description>
      <addressOffset>0x00</addressOffset>
      <size>8</size>
      <access>read-write</access>
      <resetValue>0x00</resetValue>
      <fields>
        <field><name>DRQ</name><description>DTS transfer request pending (read-only)</description><bitRange>[7:7]</bitRange></field>
        <field><name>DRQSET</name><description>Write 1 to set DRQ bit</description><bitRange>[6:6]</bitRange></field>
        <field><name>DRQCLR</name><description>Write 1 to clear DRQ bit</description><bitRange>[5:5]</bitRange></field>
        <field><name>DTSEN</name><description>DTS transfer request enable for this channel</description><bitRange>[2:2]</bitRange></field>
        <field><name>DTSPR1</name><description>Priority level bit 1</description><bitRange>[1:1]</bitRange></field>
        <field><name>DTSPR0</name><description>Priority level bit 0</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>
    <register><name>DTSEN1</name><description>DTS Transfer Enable Register channel 1</description><addressOffset>0x02</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN2</name><description>DTS Transfer Enable Register channel 2</description><addressOffset>0x04</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN3</name><description>DTS Transfer Enable Register channel 3</description><addressOffset>0x06</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN4</name><description>DTS Transfer Enable Register channel 4</description><addressOffset>0x08</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN5</name><description>DTS Transfer Enable Register channel 5</description><addressOffset>0x0A</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN6</name><description>DTS Transfer Enable Register channel 6</description><addressOffset>0x0C</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN7</name><description>DTS Transfer Enable Register channel 7</description><addressOffset>0x0E</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN8</name><description>DTS Transfer Enable Register channel 8</description><addressOffset>0x10</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN9</name><description>DTS Transfer Enable Register channel 9</description><addressOffset>0x12</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN10</name><description>DTS Transfer Enable Register channel 10</description><addressOffset>0x14</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN11</name><description>DTS Transfer Enable Register channel 11</description><addressOffset>0x16</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN12</name><description>DTS Transfer Enable Register channel 12</description><addressOffset>0x18</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN13</name><description>DTS Transfer Enable Register channel 13</description><addressOffset>0x1A</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN14</name><description>DTS Transfer Enable Register channel 14</description><addressOffset>0x1C</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN15</name><description>DTS Transfer Enable Register channel 15</description><addressOffset>0x1E</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN16</name><description>DTS Transfer Enable Register channel 16</description><addressOffset>0x20</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN17</name><description>DTS Transfer Enable Register channel 17</description><addressOffset>0x22</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN18</name><description>DTS Transfer Enable Register channel 18</description><addressOffset>0x24</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN19</name><description>DTS Transfer Enable Register channel 19</description><addressOffset>0x26</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN20</name><description>DTS Transfer Enable Register channel 20</description><addressOffset>0x28</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN21</name><description>DTS Transfer Enable Register channel 21</description><addressOffset>0x2A</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN22</name><description>DTS Transfer Enable Register channel 22</description><addressOffset>0x2C</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN23</name><description>DTS Transfer Enable Register channel 23</description><addressOffset>0x2E</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN24</name><description>DTS Transfer Enable Register channel 24</description><addressOffset>0x30</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN25</name><description>DTS Transfer Enable Register channel 25</description><addressOffset>0x32</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN26</name><description>DTS Transfer Enable Register channel 26</description><addressOffset>0x34</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN27</name><description>DTS Transfer Enable Register channel 27</description><addressOffset>0x36</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN28</name><description>DTS Transfer Enable Register channel 28</description><addressOffset>0x38</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN29</name><description>DTS Transfer Enable Register channel 29</description><addressOffset>0x3A</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN30</name><description>DTS Transfer Enable Register channel 30</description><addressOffset>0x3C</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN31</name><description>DTS Transfer Enable Register channel 31</description><addressOffset>0x3E</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN32</name><description>DTS Transfer Enable Register channel 32</description><addressOffset>0x40</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN33</name><description>DTS Transfer Enable Register channel 33</description><addressOffset>0x42</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN34</name><description>DTS Transfer Enable Register channel 34</description><addressOffset>0x44</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN35</name><description>DTS Transfer Enable Register channel 35</description><addressOffset>0x46</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN36</name><description>DTS Transfer Enable Register channel 36</description><addressOffset>0x48</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN37</name><description>DTS Transfer Enable Register channel 37</description><addressOffset>0x4A</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN38</name><description>DTS Transfer Enable Register channel 38</description><addressOffset>0x4C</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN39</name><description>DTS Transfer Enable Register channel 39</description><addressOffset>0x4E</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN40</name><description>DTS Transfer Enable Register channel 40</description><addressOffset>0x50</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN41</name><description>DTS Transfer Enable Register channel 41</description><addressOffset>0x52</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN42</name><description>DTS Transfer Enable Register channel 42</description><addressOffset>0x54</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN43</name><description>DTS Transfer Enable Register channel 43</description><addressOffset>0x56</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN44</name><description>DTS Transfer Enable Register channel 44</description><addressOffset>0x58</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN45</name><description>DTS Transfer Enable Register channel 45</description><addressOffset>0x5A</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN46</name><description>DTS Transfer Enable Register channel 46</description><addressOffset>0x5C</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN47</name><description>DTS Transfer Enable Register channel 47</description><addressOffset>0x5E</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN48</name><description>DTS Transfer Enable Register channel 48</description><addressOffset>0x60</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN49</name><description>DTS Transfer Enable Register channel 49</description><addressOffset>0x62</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
    <register><name>DTSEN50</name><description>DTS Transfer Enable Register channel 50</description><addressOffset>0x64</addressOffset><size>8</size><access>read-write</access><resetValue>0x00</resetValue></register>
