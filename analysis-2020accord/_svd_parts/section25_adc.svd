<peripheral>
  <name>ADCA0_CTRL</name>
  <description>A/D Converter A0 - Control/Config register block (ADCAn_base0=0xFF81D000, offsets 0x100-0x123)</description>
  <baseAddress>0xFF81D100</baseAddress>
  <addressBlock><offset>0x0</offset><size>0x24</size><usage>registers</usage></addressBlock>
  <registers>
    <register>
      <name>ADCA0CTL0</name>
      <description>A/D Converter Mode Control Register 0</description>
      <addressOffset>0x0</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field>
          <name>ADCA0OEM4</name>
          <description>Error interrupt mask for LCR overwrite (0=generate, 1=suppress)</description>
          <bitRange>[12:12]</bitRange>
        </field>
        <field>
          <name>ADCA0OEM3</name>
          <description>Error interrupt mask for DB2CR overwrite</description>
          <bitRange>[11:11]</bitRange>
        </field>
        <field>
          <name>ADCA0OEM2</name>
          <description>Error interrupt mask for DB1CR overwrite</description>
          <bitRange>[10:10]</bitRange>
        </field>
        <field>
          <name>ADCA0OEM1</name>
          <description>Error interrupt mask for DB0CR overwrite</description>
          <bitRange>[9:9]</bitRange>
        </field>
        <field>
          <name>ADCA0OEM0</name>
          <description>Error interrupt mask for CmCR overwrite</description>
          <bitRange>[8:8]</bitRange>
        </field>
        <field>
          <name>ADCA0CE</name>
          <description>A/D converter enable (0=disable, 1=enable)</description>
          <bitRange>[7:7]</bitRange>
        </field>
        <field>
          <name>ADCA0SCT2</name>
          <description>CG2 scan list repetitions in one-shot mode (00=1,01=2,10=3,11=4)</description>
          <bitRange>[5:4]</bitRange>
        </field>
        <field>
          <name>ADCA0SCT1</name>
          <description>CG1 scan list repetitions in one-shot mode</description>
          <bitRange>[3:2]</bitRange>
        </field>
        <field>
          <name>ADCA0SCT0</name>
          <description>CG0 scan list repetitions in one-shot mode</description>
          <bitRange>[1:0]</bitRange>
        </field>
      </fields>
    </register>
    <register>
      <name>ADCA0CTL1</name>
      <description>A/D Converter Mode Control Register 1</description>
      <addressOffset>0x4</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x01000008</resetValue>
      <fields>
        <field>
          <name>ADCA0T2ETS</name>
          <description>Valid edge of HW trigger ADCAnTTRG2 (00=none,01=rise,10=fall,11=both)</description>
          <bitRange>[31:30]</bitRange>
        </field>
        <field>
          <name>ADCA0T1ETS</name>
          <description>Valid edge of HW trigger ADCAnTTRG1</description>
          <bitRange>[29:28]</bitRange>
        </field>
        <field>
          <name>ADCA0T0ETS</name>
          <description>Valid edge of HW trigger ADCAnTTRG0</description>
          <bitRange>[27:26]</bitRange>
        </field>
        <field>
          <name>ADCA0CRAC</name>
          <description>Conversion result alignment (0=right-aligned, 1=left-aligned)</description>
          <bitRange>[24:24]</bitRange>
        </field>
        <field>
          <name>ADCA0MD1</name>
          <description>CG0 start trigger mode (0=SW only, 1=HW+SW)</description>
          <bitRange>[21:21]</bitRange>
        </field>
        <field>
          <name>ADCA0MD0</name>
          <description>CG0 conversion mode (0=one-shot, 1=continuous)</description>
          <bitRange>[20:20]</bitRange>
        </field>
        <field>
          <name>ADCA0DISC</name>
          <description>Discharge function enable (0=disable, 1=enable)</description>
          <bitRange>[17:17]</bitRange>
        </field>
        <field>
          <name>ADCA0RCL</name>
          <description>Result clear-on-read (0=retain until overwrite, 1=clear after read)</description>
          <bitRange>[16:16]</bitRange>
        </field>
        <field>
          <name>ADCA0CTYP</name>
          <description>Resolution select (0=12-bit, 1=10-bit)</description>
          <bitRange>[15:15]</bitRange>
        </field>
        <field>
          <name>ADCA0STL</name>
          <description>ADCAnCNVi signal polarity (0=high=active, 1=low=active)</description>
          <bitRange>[12:12]</bitRange>
        </field>
        <field>
          <name>ADCA0FR</name>
          <description>ADCAnTCLK clock divider (0000=PCLK/2 ... 1110=PCLK/16)</description>
          <bitRange>[11:8]</bitRange>
        </field>
        <field>
          <name>ADCA0TRM</name>
          <description>Higher-priority interrupt behavior (bit5=CG1, bit4=CG0)</description>
          <bitRange>[5:4]</bitRange>
        </field>
        <field>
          <name>ADCA0BPC</name>
          <description>Buffer amplifier enable (0=disable, 1=enable)</description>
          <bitRange>[3:3]</bitRange>
        </field>
        <field>
          <name>ADCA0GPS</name>
          <description>A/D converter power (0=off, 1=on)</description>
          <bitRange>[0:0]</bitRange>
        </field>
      </fields>
    </register>
    <register>
      <name>ADCA0TSEL0</name>
      <description>A/D Converter Trigger Select Control Register 0 (CG0)</description>
      <addressOffset>0x8</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field>
          <name>ADCA0T0SEL</name>
          <description>HW trigger source select bitmask for CG0 (bit n=TTINn0n)</description>
          <bitRange>[15:0]</bitRange>
        </field>
      </fields>
    </register>
    <register>
      <name>ADCA0TSEL1</name>
      <description>A/D Converter Trigger Select Control Register 1 (CG1)</description>
      <addressOffset>0xC</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field>
          <name>ADCA0T1SEL</name>
          <description>HW trigger source select bitmask for CG1 (bit n=TTINn0n)</description>
          <bitRange>[15:0]</bitRange>
        </field>
      </fields>
    </register>
    <register>
      <name>ADCA0TSEL2</name>
      <description>A/D Converter Trigger Select Control Register 2 (CG2)</description>
      <addressOffset>0x10</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field>
          <name>ADCA0T2SEL</name>
          <description>HW trigger source select bitmask for CG2 (bit n=TTINn0n)</description>
          <bitRange>[15:0]</bitRange>
        </field>
      </fields>
    </register>
    <register>
      <name>ADCA0CNT</name>
      <description>A/D Converter Stabilization Counter</description>
      <addressOffset>0x14</addressOffset>
      <size>8</size>
      <access>read-write</access>
      <resetValue>0x00</resetValue>
      <fields>
        <field>
          <name>ADCA0CNT</name>
          <description>Stabilization time = CNT[7:0] x PCLK cycles</description>
          <bitRange>[7:0]</bitRange>
        </field>
      </fields>
    </register>
    <register>
      <name>ADCA0SHCTL</name>
      <description>A/D Converter Channel Sample and Hold Control Register</description>
      <addressOffset>0x18</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <fields>
        <field>
          <name>ADCA0CPS</name>
          <description>Channel S/H power supply control bits [12:0] (bit x-1 = CHx)</description>
          <bitRange>[28:16]</bitRange>
        </field>
        <field>
          <name>ADCA0CSEL</name>
          <description>Channel S/H function enable bits [12:0] (bit x-1 = CHx)</description>
          <bitRange>[12:0]</bitRange>
        </field>
      </fields>
    </register>
    <register>
      <name>ADCA0DGCTL1</name>
      <description>A/D Converter Self-Diagnosis Function Control Register 1</description>
      <addressOffset>0x1C</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <fields>
        <field>
          <name>ADCA0CDG</name>
          <description>Diagnostic voltage select per channel (0=analog pin, 1=reference voltage)</description>
          <bitRange>[23:0]</bitRange>
        </field>
      </fields>
    </register>
    <register>
      <name>ADCA0PDCTL0</name>
      <description>A/D Converter Internal Pull-Down Resistance Control Register 0</description>
      <addressOffset>0x20</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <fields>
        <field>
          <name>ADCA0PDNA</name>
          <description>Internal pull-down resistor per channel (bit n-1 = CHn)</description>
          <bitRange>[23:0]</bitRange>
        </field>
      </fields>
    </register>
  </registers>
</peripheral>

<peripheral>
  <name>ADCA0_DATA</name>
  <description>A/D Converter A0 - Data/Status/Trigger register block (ADCAn_base1=0xFFFFDC00, offsets 0x00-0xDD)</description>
  <baseAddress>0xFFFFDC00</baseAddress>
  <addressBlock><offset>0x0</offset><size>0xDE</size><usage>registers</usage></addressBlock>
  <registers>
    <register>
      <name>ADCA0CG0</name>
      <description>A/D Converter Channel Group Register 0 (scan list)</description>
      <addressOffset>0x0</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <fields>
        <field>
          <name>ADCA0DIAG</name>
          <description>Enable diagnostic ADDIAGOUT conversion after CG0 scan (CG0 only)</description>
          <bitRange>[31:31]</bitRange>
        </field>
        <field>
          <name>ADCA0CG0S</name>
          <description>Channel scan list bitmask for CG0 (bit n-1=CHn, bits 23:0)</description>
          <bitRange>[23:0]</bitRange>
        </field>
      </fields>
    </register>
    <register>
      <name>ADCA0CG1</name>
      <description>A/D Converter Channel Group Register 1 (scan list)</description>
      <addressOffset>0x4</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <fields>
        <field>
          <name>ADCA0CG1S</name>
          <description>Channel scan list bitmask for CG1 (bit n-1=CHn, bits 23:0)</description>
          <bitRange>[23:0]</bitRange>
        </field>
      </fields>
    </register>
    <register>
      <name>ADCA0CG2</name>
      <description>A/D Converter Channel Group Register 2 (scan list)</description>
      <addressOffset>0x8</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <fields>
        <field>
          <name>ADCA0CG2S</name>
          <description>Channel scan list bitmask for CG2 (bit n-1=CHn, bits 23:0)</description>
          <bitRange>[23:0]</bitRange>
        </field>
      </fields>
    </register>
    <register>
      <name>ADCA0IOC0</name>
      <description>A/D Converter Interrupt Control Register 0</description>
      <addressOffset>0xC</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <fields>
        <field>
          <name>ADCA0CG0IDG</name>
          <description>Generate INTADCAnT0 on diagnostic conversion completion (CG0 only)</description>
          <bitRange>[31:31]</bitRange>
        </field>
        <field>
          <name>ADCA0CG0I</name>
          <description>Interrupt enable per channel for CG0 (bit n-1=CHn, 0=no INT, 1=INT)</description>
          <bitRange>[23:0]</bitRange>
        </field>
      </fields>
    </register>
    <register>
      <name>ADCA0IOC1</name>
      <description>A/D Converter Interrupt Control Register 1</description>
      <addressOffset>0x10</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <fields>
        <field>
          <name>ADCA0CG1I</name>
          <description>Interrupt enable per channel for CG1 (bit n-1=CHn, 0=no INT, 1=INT)</description>
          <bitRange>[23:0]</bitRange>
        </field>
      </fields>
    </register>
    <register>
      <name>ADCA0IOC2</name>
      <description>A/D Converter Interrupt Control Register 2</description>
      <addressOffset>0x14</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <fields>
        <field>
          <name>ADCA0CG2I</name>
          <description>Interrupt enable per channel for CG2 (bit n-1=CHn, 0=no INT, 1=INT)</description>
          <bitRange>[23:0]</bitRange>
        </field>
      </fields>
    </register>
    <register>
      <name>ADCA0CTL2</name>
      <description>A/D Conversion Result Check Register (upper/lower limit enable per channel)</description>
      <addressOffset>0x18</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <fields>
        <field>
          <name>ADCA0RCK</name>
          <description>Upper/lower limit comparison enable per channel (bit n-1=CHn)</description>
          <bitRange>[23:0]</bitRange>
        </field>
      </fields>
    </register>
    <register>
      <name>ADCA0UL</name>
      <description>A/D Conversion Result Upper Limit</description>
      <addressOffset>0x1C</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field>
          <name>ADCA0ULV</name>
          <description>Upper limit value for result range check (bits 11:0)</description>
          <bitRange>[11:0]</bitRange>
        </field>
      </fields>
    </register>
    <register>
      <name>ADCA0LL</name>
      <description>A/D Conversion Result Lower Limit</description>
      <addressOffset>0x20</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field>
          <name>ADCA0LLV</name>
          <description>Lower limit value for result range check (bits 11:0)</description>
          <bitRange>[11:0]</bitRange>
        </field>
      </fields>
    </register>
    <register>
      <name>ADCA0STR0</name>
      <description>A/D Converter Result Upper/Lower Limit Comparison Error Flag</description>
      <addressOffset>0x24</addressOffset>
      <size>32</size>
      <access>read-only</access>
      <resetValue>0x00000000</resetValue>
      <fields>
        <field>
          <name>ADCA0RCE</name>
          <description>Result out-of-range error per channel (bit n-1=CHn)</description>
          <bitRange>[23:0]</bitRange>
        </field>
      </fields>
    </register>
    <register>
      <name>ADCA0STR1</name>
      <description>A/D Converter Overwrite Error Flag Register</description>
      <addressOffset>0x28</addressOffset>
      <size>32</size>
      <access>read-only</access>
      <resetValue>0x00000000</resetValue>
      <fields>
        <field>
          <name>ADCA0OWE</name>
          <description>Overwrite error per channel (bit n-1=CHn)</description>
          <bitRange>[23:0]</bitRange>
        </field>
      </fields>
    </register>
    <register>
      <name>ADCA0STR2</name>
      <description>A/D Converter Status Flag Register 2</description>
      <addressOffset>0x2C</addressOffset>
      <size>16</size>
      <access>read-only</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field>
          <name>ADCA0RQ</name>
          <description>Conversion request pending per CG (bits 10:8, bit i=CGi)</description>
          <bitRange>[10:8]</bitRange>
        </field>
        <field>
          <name>ADCA0ST</name>
          <description>Conversion currently active per CG (bits 2:0, bit i=CGi)</description>
          <bitRange>[2:0]</bitRange>
        </field>
      </fields>
    </register>
    <register>
      <name>ADCA0STC0</name>
      <description>ADCAnSTR0 Flag Clear Register</description>
      <addressOffset>0x30</addressOffset>
      <size>32</size>
      <access>write-only</access>
      <resetValue>0x00000000</resetValue>
      <fields>
        <field>
          <name>ADCA0RCEC</name>
          <description>Clear result range error flags (write 1 to clear; bit n-1=CHn)</description>
          <bitRange>[23:0]</bitRange>
        </field>
      </fields>
    </register>
    <register>
      <name>ADCA0STC1</name>
      <description>ADCAnSTR1 Flag Clear Register</description>
      <addressOffset>0x34</addressOffset>
      <size>32</size>
      <access>write-only</access>
      <resetValue>0x00000000</resetValue>
      <fields>
        <field>
          <name>ADCA0OWEC</name>
          <description>Clear overwrite error flags (write 1 to clear; bit n-1=CHn)</description>
          <bitRange>[23:0]</bitRange>
        </field>
      </fields>
    </register>
    <register>
      <name>ADCA0STC2</name>
      <description>ADCAnSTR2 Flag Clear Register</description>
      <addressOffset>0x38</addressOffset>
      <size>8</size>
      <access>write-only</access>
      <resetValue>0x00</resetValue>
      <fields>
        <field>
          <name>ADCA0LERC1</name>
          <description>Clear LCR overwrite flag (write 1 to clear)</description>
          <bitRange>[7:7]</bitRange>
        </field>
        <field>
          <name>ADCA0LERC0</name>
          <description>Clear LCR result-check error flag</description>
          <bitRange>[6:6]</bitRange>
        </field>
        <field>
          <name>ADCA0DB2ERC1</name>
          <description>Clear DB2CR overwrite flag</description>
          <bitRange>[5:5]</bitRange>
        </field>
        <field>
          <name>ADCA0DB2ERC0</name>
          <description>Clear DB2CR result-check error flag</description>
          <bitRange>[4:4]</bitRange>
        </field>
        <field>
          <name>ADCA0DB1ERC1</name>
          <description>Clear DB1CR overwrite flag</description>
          <bitRange>[3:3]</bitRange>
        </field>
        <field>
          <name>ADCA0DB1ERC0</name>
          <description>Clear DB1CR result-check error flag</description>
          <bitRange>[2:2]</bitRange>
        </field>
        <field>
          <name>ADCA0DB0ERC1</name>
          <description>Clear DB0CR overwrite flag</description>
          <bitRange>[1:1]</bitRange>
        </field>
        <field>
          <name>ADCA0DB0ERC0</name>
          <description>Clear DB0CR result-check error flag</description>
          <bitRange>[0:0]</bitRange>
        </field>
      </fields>
    </register>
    <register>
      <name>ADCA0C01CR</name>
      <description>A/D Converter Conversion Result Register Channel 1</description>
      <addressOffset>0x40</addressOffset>
      <size>32</size>
      <access>read-only</access>
      <resetValue>0x03010000</resetValue>
      <fields>
        <field>
          <name>C01CG</name>
          <description>CG that produced CH1 result (00=CG0,01=CG1,10=CG2,11=none)</description>
          <bitRange>[25:24]</bitRange>
        </field>
        <field>
          <name>C01ER1</name>
          <description>Overwrite error for CH1 (mirrors STR1.OWEm)</description>
          <bitRange>[23:23]</bitRange>
        </field>
        <field>
          <name>C01ER0</name>
          <description>Result range error for CH1 (mirrors STR0.RCEm)</description>
          <bitRange>[22:22]</bitRange>
        </field>
        <field>
          <name>C01UR</name>
          <description>Unread flag for CH1 (1=not yet read)</description>
          <bitRange>[21:21]</bitRange>
        </field>
        <field>
          <name>C01CN</name>
          <description>Channel number of stored result (bits 20:16; fixed = 0x01)</description>
          <bitRange>[20:16]</bitRange>
        </field>
        <field>
          <name>C01CR</name>
          <description>A/D conversion result value for CH1 (bits 15:0)</description>
          <bitRange>[15:0]</bitRange>
        </field>
      </fields>
    </register>
    <register>
      <name>ADCA0C02CR</name>
      <description>A/D Converter Conversion Result Register Channel 2</description>
      <addressOffset>0x44</addressOffset>
      <size>32</size>
      <access>read-only</access>
      <resetValue>0x03020000</resetValue>
      <fields>
        <field>
          <name>C02CG</name>
          <description>CG that produced CH2 result (00=CG0,01=CG1,10=CG2,11=none)</description>
          <bitRange>[25:24]</bitRange>
        </field>
        <field>
          <name>C02ER1</name>
          <description>Overwrite error for CH2 (mirrors STR1.OWEm)</description>
          <bitRange>[23:23]</bitRange>
        </field>
        <field>
          <name>C02ER0</name>
          <description>Result range error for CH2 (mirrors STR0.RCEm)</description>
          <bitRange>[22:22]</bitRange>
        </field>
        <field>
          <name>C02UR</name>
          <description>Unread flag for CH2 (1=not yet read)</description>
          <bitRange>[21:21]</bitRange>
        </field>
        <field>
          <name>C02CN</name>
          <description>Channel number of stored result (bits 20:16; fixed = 0x02)</description>
          <bitRange>[20:16]</bitRange>
        </field>
        <field>
          <name>C02CR</name>
          <description>A/D conversion result value for CH2 (bits 15:0)</description>
          <bitRange>[15:0]</bitRange>
        </field>
      </fields>
    </register>
    <register>
      <name>ADCA0C03CR</name>
      <description>A/D Converter Conversion Result Register Channel 3</description>
      <addressOffset>0x48</addressOffset>
      <size>32</size>
      <access>read-only</access>
      <resetValue>0x03030000</resetValue>
      <fields>
        <field>
          <name>C03CG</name>
          <description>CG that produced CH3 result (00=CG0,01=CG1,10=CG2,11=none)</description>
          <bitRange>[25:24]</bitRange>
        </field>
        <field>
          <name>C03ER1</name>
          <description>Overwrite error for CH3 (mirrors STR1.OWEm)</description>
          <bitRange>[23:23]</bitRange>
        </field>
        <field>
          <name>C03ER0</name>
          <description>Result range error for CH3 (mirrors STR0.RCEm)</description>
          <bitRange>[22:22]</bitRange>
        </field>
        <field>
          <name>C03UR</name>
          <description>Unread flag for CH3 (1=not yet read)</description>
          <bitRange>[21:21]</bitRange>
        </field>
        <field>
          <name>C03CN</name>
          <description>Channel number of stored result (bits 20:16; fixed = 0x03)</description>
          <bitRange>[20:16]</bitRange>
        </field>
        <field>
          <name>C03CR</name>
          <description>A/D conversion result value for CH3 (bits 15:0)</description>
          <bitRange>[15:0]</bitRange>
        </field>
      </fields>
    </register>
    <register>
      <name>ADCA0C04CR</name>
      <description>A/D Converter Conversion Result Register Channel 4</description>
      <addressOffset>0x4C</addressOffset>
      <size>32</size>
      <access>read-only</access>
      <resetValue>0x03040000</resetValue>
      <fields>
        <field>
          <name>C04CG</name>
          <description>CG that produced CH4 result (00=CG0,01=CG1,10=CG2,11=none)</description>
          <bitRange>[25:24]</bitRange>
