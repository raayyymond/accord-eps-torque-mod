      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <fields>
        <field>
          <name>TS0PRE</name>
          <description>Enables/disables peak reload timing</description>
          <bitRange>[8:8]</bitRange>
        </field>
        <field>
          <name>TS0VRE</name>
          <description>Enables/disables valley reload timing (valid in HT-PWM mode only)</description>
          <bitRange>[7:7]</bitRange>
        </field>
        <field>
          <name>TS0PIE</name>
          <description>Enables/disables peak interrupt (INTTSG2nIPEK) generation</description>
          <bitRange>[6:6]</bitRange>
        </field>
        <field>
          <name>TS0VIE</name>
          <description>Enables/disables valley interrupt (INTTSG2nIVLY) generation (HT-PWM only)</description>
          <bitRange>[5:5]</bitRange>
        </field>
      </fields>
    </register>
    <register>
