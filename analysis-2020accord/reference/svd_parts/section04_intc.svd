<peripheral>
  <name>INTC_CFG</name>
  <description>Interrupt Controller FE/EI Switch and Flag Registers</description>
  <baseAddress>0xFF83A000</baseAddress>
  <addressBlock><offset>0x0</offset><size>0x10</size><usage>registers</usage></addressBlock>
  <registers>
    <register>
      <name>INTCFGB</name>
      <description>FE Level Interrupt Switch Register</description>
      <addressOffset>0x0</addressOffset>
      <size>8</size>
      <access>read-write</access>
      <resetValue>0x00</resetValue>
      <fields>
        <field><name>INTCFGSL0</name><description>FE-to-EI level switch (0=FE 1=EI for INTCME/ISG/WDTA0NMI/CLMA0-2)</description><bitRange>[7:7]</bitRange></field>
      </fields>
    </register>
    <register>
      <name>INTSTR0B</name>
      <description>Interrupt Request Flag Storage Register</description>
      <addressOffset>0x4</addressOffset>
      <size>8</size>
      <access>read-only</access>
      <resetValue>0x00</resetValue>
      <fields>
        <field><name>INTISTF5</name><description>INTCLMA2 interrupt request flag</description><bitRange>[5:5]</bitRange></field>
        <field><name>INTISTF4</name><description>INTCLMA1 interrupt request flag</description><bitRange>[4:4]</bitRange></field>
        <field><name>INTISTF3</name><description>INTCLMA0 interrupt request flag</description><bitRange>[3:3]</bitRange></field>
        <field><name>INTISTF2</name><description>INTWDTA0NMI interrupt request flag</description><bitRange>[2:2]</bitRange></field>
        <field><name>INTISTF1</name><description>INTISG interrupt request flag</description><bitRange>[1:1]</bitRange></field>
        <field><name>INTISTF0</name><description>INTCME interrupt request flag</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>
    <register>
      <name>INTSTC0B</name>
      <description>Interrupt Request Flag Clearing Register</description>
      <addressOffset>0x8</addressOffset>
      <size>8</size>
      <access>write-only</access>
      <resetValue>0x00</resetValue>
      <fields>
        <field><name>INTISTC5</name><description>Clear INTISTF5 flag</description><bitRange>[5:5]</bitRange></field>
        <field><name>INTISTC4</name><description>Clear INTISTF4 flag</description><bitRange>[4:4]</bitRange></field>
        <field><name>INTISTC3</name><description>Clear INTISTF3 flag</description><bitRange>[3:3]</bitRange></field>
        <field><name>INTISTC2</name><description>Clear INTISTF2 flag</description><bitRange>[2:2]</bitRange></field>
        <field><name>INTISTC1</name><description>Clear INTISTF1 flag</description><bitRange>[1:1]</bitRange></field>
        <field><name>INTISTC0</name><description>Clear INTISTF0 flag</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>
    <register>
      <name>INTSTS0B</name>
      <description>Interrupt Request Flag Setting Register</description>
      <addressOffset>0xC</addressOffset>
      <size>8</size>
      <access>write-only</access>
      <resetValue>0x00</resetValue>
      <fields>
        <field><name>INTISTS5</name><description>Set INTISTF5 flag</description><bitRange>[5:5]</bitRange></field>
        <field><name>INTISTS4</name><description>Set INTISTF4 flag</description><bitRange>[4:4]</bitRange></field>
        <field><name>INTISTS3</name><description>Set INTISTF3 flag</description><bitRange>[3:3]</bitRange></field>
        <field><name>INTISTS2</name><description>Set INTISTF2 flag</description><bitRange>[2:2]</bitRange></field>
        <field><name>INTISTS1</name><description>Set INTISTF1 flag</description><bitRange>[1:1]</bitRange></field>
        <field><name>INTISTS0</name><description>Set INTISTF0 flag</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>
  </registers>
</peripheral>
