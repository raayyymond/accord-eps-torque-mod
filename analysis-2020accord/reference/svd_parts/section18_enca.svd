          <name>CRM1</name>
          <description>CCR1 mode select: 0=comparison register, 1=capture register</description>
          <bitRange>[9:9]</bitRange>
        </field>
        <field>
          <name>CRM0</name>
          <description>CCR0 mode select: 0=comparison register, 1=capture register</description>
          <bitRange>[8:8]</bitRange>
        </field>
        <field>
          <name>CTS</name>
          <description>CCR1 capture trigger select: 0=ENCAnI1 input, 1=ENCAnEC input (valid when CRM1=1)</description>
