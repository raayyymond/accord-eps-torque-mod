</peripheral>

<!-- ===== ENCA1 base0 group (0xFF81A040) ===== -->
<peripheral>
  <name>ENCA1_CTL</name>
  <description>Encoder Timer 1 — control register bank (base0+0x40 = 0xFF81A040)</description>
  <baseAddress>0xFF81A040</baseAddress>
  <addressBlock><offset>0x0</offset><size>0x6</size><usage>registers</usage></addressBlock>
  <registers>

    <register>
      <name>ENCA1CTL</name>
      <description>ENCA1 Control Register — 16-bit, write prohibited during operation</description>
      <addressOffset>0x0</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field>
          <name>CME</name>
          <description>Compare-match interrupt mask enable: 0=disable masking, 1=enable masking</description>
          <bitRange>[15:15]</bitRange>
        </field>
