    <register>
      <name>ENCA1TE</name>
      <description>ENCA1 Timer Enable Status Register</description>
      <addressOffset>0x14</addressOffset>
      <size>8</size>
      <access>read-only</access>
      <resetValue>0x00</resetValue>
      <fields>
        <field>
          <name>TE</name>
          <description>Timer operation status: 0=stopped, 1=enabled</description>
          <bitRange>[0:0]</bitRange>
