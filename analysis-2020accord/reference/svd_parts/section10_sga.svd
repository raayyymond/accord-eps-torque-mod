        <field><name>SGAMSSE004C</name><description>SGATERRIN4 majority-C status</description><bitRange>[4:4]</bitRange></field>
        <field><name>SGAMSSE003C</name><description>SGATERRIN3 majority-C status</description><bitRange>[3:3]</bitRange></field>
        <field><name>SGAMSSE002C</name><description>SGATERRIN2 majority-C status</description><bitRange>[2:2]</bitRange></field>
        <field><name>SGAMSSE001C</name><description>SGATERRIN1 majority-C status</description><bitRange>[1:1]</bitRange></field>
