        <field><name>SGAMSSE013C</name><description>SGATERRIN13 majority-C status</description><bitRange>[13:13]</bitRange></field>
        <field><name>SGAMSSE012C</name><description>SGATERRIN12 majority-C status</description><bitRange>[12:12]</bitRange></field>
        <field><name>SGAMSSE011C</name><description>SGATERRIN11 majority-C status</description><bitRange>[11:11]</bitRange></field>
        <field><name>SGAMSSE010C</name><description>SGATERRIN10 majority-C status</description><bitRange>[10:10]</bitRange></field>
        <field><name>SGAMSSE009C</name><description>SGATERRIN9 majority-C status</description><bitRange>[9:9]</bitRange></field>
        <field><name>SGAMSSE008C</name><description>SGATERRIN8 majority-C status</description><bitRange>[8:8]</bitRange></field>
        <field><name>SGAMSSE007C</name><description>SGATERRIN7 majority-C status</description><bitRange>[7:7]</bitRange></field>
        <field><name>SGAMSSE006C</name><description>SGATERRIN6 majority-C status</description><bitRange>[6:6]</bitRange></field>
