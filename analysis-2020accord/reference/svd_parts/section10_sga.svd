<!-- Section 10: Safety Guardian (SGA) — UPD70F3508 -->
<!-- Base addresses (Table 10-2):                      -->
<!--   SGAM_base = 0xFF83C000                          -->
<!--   SGAC_base = 0xFF83D000                          -->
<!--   SGA_base  = 0xFF83E000                          -->
<!-- SGAEPCTL at absolute 0xFF83F020 (own peripheral)  -->

<!-- ═══════════════════════════════════════════════════
     SGAM — SGA Master register area
     Registers: Table 10-8 + detail subsections (1)–(7)
     ═══════════════════════════════════════════════════ -->
<peripheral>
  <name>SGAM</name>
  <description>Safety Guardian Master register area</description>
  <baseAddress>0xFF83C000</baseAddress>
  <addressBlock><offset>0x0</offset><size>0x38</size><usage>registers</usage></addressBlock>
  <registers>

    <!-- (1) SGAMESET — SGA Master Error Set Trigger Register -->
    <register>
      <name>SGAMESET</name>
      <description>SGA master error set trigger register</description>
      <addressOffset>0x0</addressOffset>
      <size>32</size>
      <access>write-only</access>
      <resetValue>0x00000000</resetValue>
      <fields>
        <field>
          <name>SGAMEST</name>
          <description>SGA error set trigger: 1=initiate active state of SGATERROUTZ (low)</description>
          <bitRange>[0:0]</bitRange>
        </field>
      </fields>
    </register>

    <!-- (2) SGAMECLR — SGA Master Error Clear Trigger Register -->
    <register>
      <name>SGAMECLR</name>
      <description>SGA master error clear trigger register</description>
      <addressOffset>0x4</addressOffset>
      <size>32</size>
      <access>write-only</access>
      <resetValue>0x00000000</resetValue>
      <fields>
        <field>
          <name>SGAMECT</name>
          <description>SGA error clear trigger: 1=initiate inactive state of SGATERROUTZ (high)</description>
          <bitRange>[0:0]</bitRange>
        </field>
      </fields>
    </register>

    <!-- (3) SGAMESSTR0 — SGA Master Error Source Status Register 0 -->
    <register>
      <name>SGAMESSTR0</name>
      <description>SGA master error source status register 0</description>
      <addressOffset>0x8</addressOffset>
      <size>32</size>
      <access>read-only</access>
      <resetValue>0x00000000</resetValue>
      <fields>
        <field><name>SGAMSSE019</name><description>SGATERRIN19 error status</description><bitRange>[19:19]</bitRange></field>
        <field><name>SGAMSSE018</name><description>SGATERRIN18 error status</description><bitRange>[18:18]</bitRange></field>
        <!-- bit 17 reserved -->
        <field><name>SGAMSSE016</name><description>SGATERRIN16 error status (not present on UPD70F3508/3509)</description><bitRange>[16:16]</bitRange></field>
        <field><name>SGAMSSE015</name><description>SGATERRIN15 error status</description><bitRange>[15:15]</bitRange></field>
        <field><name>SGAMSSE014</name><description>SGATERRIN14 error status</description><bitRange>[14:14]</bitRange></field>
        <field><name>SGAMSSE013</name><description>SGATERRIN13 error status</description><bitRange>[13:13]</bitRange></field>
        <field><name>SGAMSSE012</name><description>SGATERRIN12 error status</description><bitRange>[12:12]</bitRange></field>
        <field><name>SGAMSSE011</name><description>SGATERRIN11 error status</description><bitRange>[11:11]</bitRange></field>
        <field><name>SGAMSSE010</name><description>SGATERRIN10 error status</description><bitRange>[10:10]</bitRange></field>
        <field><name>SGAMSSE009</name><description>SGATERRIN9 error status</description><bitRange>[9:9]</bitRange></field>
        <field><name>SGAMSSE008</name><description>SGATERRIN8 error status</description><bitRange>[8:8]</bitRange></field>
        <field><name>SGAMSSE007</name><description>SGATERRIN7 error status</description><bitRange>[7:7]</bitRange></field>
        <field><name>SGAMSSE006</name><description>SGATERRIN6 error status</description><bitRange>[6:6]</bitRange></field>
        <field><name>SGAMSSE005</name><description>SGATERRIN5 error status</description><bitRange>[5:5]</bitRange></field>
        <field><name>SGAMSSE004</name><description>SGATERRIN4 error status</description><bitRange>[4:4]</bitRange></field>
        <field><name>SGAMSSE003</name><description>SGATERRIN3 error status</description><bitRange>[3:3]</bitRange></field>
        <field><name>SGAMSSE002</name><description>SGATERRIN2 error status</description><bitRange>[2:2]</bitRange></field>
        <field><name>SGAMSSE001</name><description>SGATERRIN1 error status</description><bitRange>[1:1]</bitRange></field>
        <field><name>SGAMSSE000</name><description>SGATERRIN0 error status</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>

    <!-- (4) SGAMESSTR1 — SGA Master Error Source Status Register 1 -->
    <register>
      <name>SGAMESSTR1</name>
      <description>SGA master error source status register 1</description>
      <addressOffset>0xC</addressOffset>
      <size>32</size>
      <access>read-only</access>
      <resetValue>0x00000000</resetValue>
      <fields>
        <field><name>SGAMSSE131</name><description>Error output loop-back state (SGATERRLB): 0=low, 1=high</description><bitRange>[31:31]</bitRange></field>
        <field><name>SGAMSSE130</name><description>SGAmESET write status (SGATERRSWS): 1=error set by SGAmEST</description><bitRange>[30:30]</bitRange></field>
        <field><name>SGAMSSE109</name><description>SGATERRIN41 error status</description><bitRange>[9:9]</bitRange></field>
        <field><name>SGAMSSE108</name><description>SGATERRIN40 error status</description><bitRange>[8:8]</bitRange></field>
        <field><name>SGAMSSE107</name><description>SGATERRIN39 error status</description><bitRange>[7:7]</bitRange></field>
        <field><name>SGAMSSE106</name><description>SGATERRIN38 error status</description><bitRange>[6:6]</bitRange></field>
        <field><name>SGAMSSE105</name><description>SGATERRIN37 error status</description><bitRange>[5:5]</bitRange></field>
        <field><name>SGAMSSE104</name><description>SGATERRIN36 error status</description><bitRange>[4:4]</bitRange></field>
        <field><name>SGAMSSE103</name><description>SGATERRIN35 error status</description><bitRange>[3:3]</bitRange></field>
        <field><name>SGAMSSE102</name><description>SGATERRIN34 error status</description><bitRange>[2:2]</bitRange></field>
        <field><name>SGAMSSE101</name><description>SGATERRIN33 error status</description><bitRange>[1:1]</bitRange></field>
        <field><name>SGAMSSE100</name><description>SGATERRIN32 error status</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>

    <!-- (5) SGAMPCMD0 — SGA Master Protection Command Register -->
    <register>
      <name>SGAMPCMD0</name>
      <description>SGA master protection command register</description>
      <addressOffset>0x10</addressOffset>
      <size>32</size>
      <access>write-only</access>
      <!-- Initial value: Undefined — resetValue omitted -->
      <fields>
        <field><name>SGAM0REG</name><description>Protection command [7:0] to enable writing to SGAM registers</description><bitRange>[7:0]</bitRange></field>
      </fields>
    </register>

    <!-- (6a) SGAMESSTR0A — SGA Master Error Source Status Register 0A (majority A) -->
    <register>
      <name>SGAMESSTR0A</name>
      <description>SGA master error source status register 0A (majority A)</description>
      <addressOffset>0x20</addressOffset>
      <size>32</size>
      <access>read-only</access>
      <resetValue>0x00000000</resetValue>
      <fields>
        <field><name>SGAMSSE019A</name><description>SGATERRIN19 majority-A status</description><bitRange>[19:19]</bitRange></field>
        <field><name>SGAMSSE018A</name><description>SGATERRIN18 majority-A status</description><bitRange>[18:18]</bitRange></field>
        <field><name>SGAMSSE016A</name><description>SGATERRIN16 majority-A status (not present on UPD70F3508/3509)</description><bitRange>[16:16]</bitRange></field>
        <field><name>SGAMSSE015A</name><description>SGATERRIN15 majority-A status</description><bitRange>[15:15]</bitRange></field>
        <field><name>SGAMSSE014A</name><description>SGATERRIN14 majority-A status</description><bitRange>[14:14]</bitRange></field>
        <field><name>SGAMSSE013A</name><description>SGATERRIN13 majority-A status</description><bitRange>[13:13]</bitRange></field>
        <field><name>SGAMSSE012A</name><description>SGATERRIN12 majority-A status</description><bitRange>[12:12]</bitRange></field>
        <field><name>SGAMSSE011A</name><description>SGATERRIN11 majority-A status</description><bitRange>[11:11]</bitRange></field>
        <field><name>SGAMSSE010A</name><description>SGATERRIN10 majority-A status</description><bitRange>[10:10]</bitRange></field>
        <field><name>SGAMSSE009A</name><description>SGATERRIN9 majority-A status</description><bitRange>[9:9]</bitRange></field>
        <field><name>SGAMSSE008A</name><description>SGATERRIN8 majority-A status</description><bitRange>[8:8]</bitRange></field>
        <field><name>SGAMSSE007A</name><description>SGATERRIN7 majority-A status</description><bitRange>[7:7]</bitRange></field>
        <field><name>SGAMSSE006A</name><description>SGATERRIN6 majority-A status</description><bitRange>[6:6]</bitRange></field>
        <field><name>SGAMSSE005A</name><description>SGATERRIN5 majority-A status</description><bitRange>[5:5]</bitRange></field>
        <field><name>SGAMSSE004A</name><description>SGATERRIN4 majority-A status</description><bitRange>[4:4]</bitRange></field>
        <field><name>SGAMSSE003A</name><description>SGATERRIN3 majority-A status</description><bitRange>[3:3]</bitRange></field>
        <field><name>SGAMSSE002A</name><description>SGATERRIN2 majority-A status</description><bitRange>[2:2]</bitRange></field>
        <field><name>SGAMSSE001A</name><description>SGATERRIN1 majority-A status</description><bitRange>[1:1]</bitRange></field>
        <field><name>SGAMSSE000A</name><description>SGATERRIN0 majority-A status</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>

    <!-- (7a) SGAMESSTR1A — SGA Master Error Source Status Register 1A (majority A) -->
    <register>
      <name>SGAMESSTR1A</name>
      <description>SGA master error source status register 1A (majority A)</description>
      <addressOffset>0x24</addressOffset>
      <size>32</size>
      <access>read-only</access>
      <resetValue>0x00000000</resetValue>
      <fields>
        <field><name>SGAMSSE130A</name><description>Error set trigger state majority-A (SGATERRSWS)</description><bitRange>[30:30]</bitRange></field>
        <field><name>SGAMSSE109A</name><description>SGATERRIN41 majority-A status</description><bitRange>[9:9]</bitRange></field>
        <field><name>SGAMSSE108A</name><description>SGATERRIN40 majority-A status</description><bitRange>[8:8]</bitRange></field>
        <field><name>SGAMSSE107A</name><description>SGATERRIN39 majority-A status</description><bitRange>[7:7]</bitRange></field>
        <field><name>SGAMSSE106A</name><description>SGATERRIN38 majority-A status</description><bitRange>[6:6]</bitRange></field>
        <field><name>SGAMSSE105A</name><description>SGATERRIN37 majority-A status</description><bitRange>[5:5]</bitRange></field>
        <field><name>SGAMSSE104A</name><description>SGATERRIN36 majority-A status</description><bitRange>[4:4]</bitRange></field>
        <field><name>SGAMSSE103A</name><description>SGATERRIN35 majority-A status</description><bitRange>[3:3]</bitRange></field>
        <field><name>SGAMSSE102A</name><description>SGATERRIN34 majority-A status</description><bitRange>[2:2]</bitRange></field>
        <field><name>SGAMSSE101A</name><description>SGATERRIN33 majority-A status</description><bitRange>[1:1]</bitRange></field>
        <field><name>SGAMSSE100A</name><description>SGATERRIN32 majority-A status</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>

    <!-- (6b) SGAMESSTR0B — SGA Master Error Source Status Register 0B (majority B) -->
    <register>
      <name>SGAMESSTR0B</name>
      <description>SGA master error source status register 0B (majority B)</description>
      <addressOffset>0x28</addressOffset>
      <size>32</size>
      <access>read-only</access>
      <resetValue>0x00000000</resetValue>
      <fields>
        <field><name>SGAMSSE019B</name><description>SGATERRIN19 majority-B status</description><bitRange>[19:19]</bitRange></field>
        <field><name>SGAMSSE018B</name><description>SGATERRIN18 majority-B status</description><bitRange>[18:18]</bitRange></field>
        <field><name>SGAMSSE016B</name><description>SGATERRIN16 majority-B status</description><bitRange>[16:16]</bitRange></field>
        <field><name>SGAMSSE015B</name><description>SGATERRIN15 majority-B status</description><bitRange>[15:15]</bitRange></field>
        <field><name>SGAMSSE014B</name><description>SGATERRIN14 majority-B status</description><bitRange>[14:14]</bitRange></field>
        <field><name>SGAMSSE013B</name><description>SGATERRIN13 majority-B status</description><bitRange>[13:13]</bitRange></field>
        <field><name>SGAMSSE012B</name><description>SGATERRIN12 majority-B status</description><bitRange>[12:12]</bitRange></field>
        <field><name>SGAMSSE011B</name><description>SGATERRIN11 majority-B status</description><bitRange>[11:11]</bitRange></field>
        <field><name>SGAMSSE010B</name><description>SGATERRIN10 majority-B status</description><bitRange>[10:10]</bitRange></field>
        <field><name>SGAMSSE009B</name><description>SGATERRIN9 majority-B status</description><bitRange>[9:9]</bitRange></field>
        <field><name>SGAMSSE008B</name><description>SGATERRIN8 majority-B status</description><bitRange>[8:8]</bitRange></field>
        <field><name>SGAMSSE007B</name><description>SGATERRIN7 majority-B status</description><bitRange>[7:7]</bitRange></field>
        <field><name>SGAMSSE006B</name><description>SGATERRIN6 majority-B status</description><bitRange>[6:6]</bitRange></field>
        <field><name>SGAMSSE005B</name><description>SGATERRIN5 majority-B status</description><bitRange>[5:5]</bitRange></field>
        <field><name>SGAMSSE004B</name><description>SGATERRIN4 majority-B status</description><bitRange>[4:4]</bitRange></field>
        <field><name>SGAMSSE003B</name><description>SGATERRIN3 majority-B status</description><bitRange>[3:3]</bitRange></field>
        <field><name>SGAMSSE002B</name><description>SGATERRIN2 majority-B status</description><bitRange>[2:2]</bitRange></field>
        <field><name>SGAMSSE001B</name><description>SGATERRIN1 majority-B status</description><bitRange>[1:1]</bitRange></field>
        <field><name>SGAMSSE000B</name><description>SGATERRIN0 majority-B status</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>

    <!-- (7b) SGAMESSTR1B — SGA Master Error Source Status Register 1B (majority B) -->
    <register>
      <name>SGAMESSTR1B</name>
      <description>SGA master error source status register 1B (majority B)</description>
      <addressOffset>0x2C</addressOffset>
      <size>32</size>
      <access>read-only</access>
      <resetValue>0x00000000</resetValue>
      <fields>
        <field><name>SGAMSSE130B</name><description>Error set trigger state majority-B (SGATERRSWS)</description><bitRange>[30:30]</bitRange></field>
        <field><name>SGAMSSE109B</name><description>SGATERRIN41 majority-B status</description><bitRange>[9:9]</bitRange></field>
        <field><name>SGAMSSE108B</name><description>SGATERRIN40 majority-B status</description><bitRange>[8:8]</bitRange></field>
        <field><name>SGAMSSE107B</name><description>SGATERRIN39 majority-B status</description><bitRange>[7:7]</bitRange></field>
        <field><name>SGAMSSE106B</name><description>SGATERRIN38 majority-B status</description><bitRange>[6:6]</bitRange></field>
        <field><name>SGAMSSE105B</name><description>SGATERRIN37 majority-B status</description><bitRange>[5:5]</bitRange></field>
        <field><name>SGAMSSE104B</name><description>SGATERRIN36 majority-B status</description><bitRange>[4:4]</bitRange></field>
        <field><name>SGAMSSE103B</name><description>SGATERRIN35 majority-B status</description><bitRange>[3:3]</bitRange></field>
        <field><name>SGAMSSE102B</name><description>SGATERRIN34 majority-B status</description><bitRange>[2:2]</bitRange></field>
        <field><name>SGAMSSE101B</name><description>SGATERRIN33 majority-B status</description><bitRange>[1:1]</bitRange></field>
        <field><name>SGAMSSE100B</name><description>SGATERRIN32 majority-B status</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>

    <!-- (6c) SGAMESSTR0C — SGA Master Error Source Status Register 0C (majority C) -->
    <register>
      <name>SGAMESSTR0C</name>
      <description>SGA master error source status register 0C (majority C)</description>
      <addressOffset>0x30</addressOffset>
      <size>32</size>
      <access>read-only</access>
      <resetValue>0x00000000</resetValue>
      <fields>
        <field><name>SGAMSSE019C</name><description>SGATERRIN19 majority-C status</description><bitRange>[19:19]</bitRange></field>
        <field><name>SGAMSSE018C</name><description>SGATERRIN18 majority-C status</description><bitRange>[18:18]</bitRange></field>
