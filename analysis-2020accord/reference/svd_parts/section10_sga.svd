    <!-- (7c) SGAMESSTR1C — SGA Master Error Source Status Register 1C (majority C) -->
    <register>
      <name>SGAMESSTR1C</name>
      <description>SGA master error source status register 1C (majority C)</description>
      <addressOffset>0x34</addressOffset>
      <size>32</size>
      <access>read-only</access>
      <resetValue>0x00000000</resetValue>
      <fields>
