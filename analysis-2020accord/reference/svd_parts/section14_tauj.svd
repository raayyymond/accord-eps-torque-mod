      <fields>
        <field><name>TOE3</name><description>Channel 3 independent timer output enable</description><bitRange>[3:3]</bitRange></field>
        <field><name>TOE2</name><description>Channel 2 independent timer output enable</description><bitRange>[2:2]</bitRange></field>
        <field><name>TOE1</name><description>Channel 1 independent timer output enable</description><bitRange>[1:1]</bitRange></field>
        <field><name>TOE0</name><description>Channel 0 independent timer output enable</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>

    <register>
      <name>TAUJ1TOL</name>
      <description>TAUJn Channel Output Active Level Register</description>
      <addressOffset>0x64</addressOffset>
      <size>8</size>
      <access>read-write</access>
      <resetValue>0x00</resetValue>
      <fields>
        <field><name>TOL3</name><description>Channel 3 output logic (0=active high, 1=active low)</description><bitRange>[3:3]</bitRange></field>
        <field><name>TOL2</name><description>Channel 2 output logic (0=active high, 1=active low)</description><bitRange>[2:2]</bitRange></field>
        <field><name>TOL1</name><description>Channel 1 output logic (0=active high, 1=active low)</description><bitRange>[1:1]</bitRange></field>
        <field><name>TOL0</name><description>Channel 0 output logic (0=active high, 1=active low)</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>

    <register>
      <name>TAUJ1RDT</name>
      <description>TAUJn Channel Reload Data Trigger Register</description>
      <addressOffset>0x68</addressOffset>
      <size>8</size>
      <access>write-only</access>
      <resetValue>0x00</resetValue>
      <fields>
        <field><name>RDT3</name><description>Trigger simultaneous rewrite pending for channel 3</description><bitRange>[3:3]</bitRange></field>
        <field><name>RDT2</name><description>Trigger simultaneous rewrite pending for channel 2</description><bitRange>[2:2]</bitRange></field>
        <field><name>RDT1</name><description>Trigger simultaneous rewrite pending for channel 1</description><bitRange>[1:1]</bitRange></field>
        <field><name>RDT0</name><description>Trigger simultaneous rewrite pending for channel 0</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>

    <register>
      <name>TAUJ1RSF</name>
      <description>TAUJn Channel Reload Status Register</description>
      <addressOffset>0x6C</addressOffset>
      <size>8</size>
      <access>read-only</access>
      <resetValue>0x00</resetValue>
      <fields>
        <field><name>RSF3</name><description>Channel 3 simultaneous rewrite pending status</description><bitRange>[3:3]</bitRange></field>
        <field><name>RSF2</name><description>Channel 2 simultaneous rewrite pending status</description><bitRange>[2:2]</bitRange></field>
        <field><name>RSF1</name><description>Channel 1 simultaneous rewrite pending status</description><bitRange>[1:1]</bitRange></field>
        <field><name>RSF0</name><description>Channel 0 simultaneous rewrite pending status</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>

  </registers>
</peripheral>
