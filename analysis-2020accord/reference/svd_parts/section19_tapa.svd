<!-- Section 19: Timer Option Module (TAPA) — UPD70F3508 -->
<!-- 4 instances: TAPA0..TAPA3. Each instance has two disjoint address regions:
       _CTL peripheral: <TAPAn_base0> + 0x20..0x24  (CTL0, CTL1)
       main peripheral: <TAPAn_base1> + 0x00..0x18  (FLG, ACWE, ACTS, ACTT, OPHS, OPHT)
     PIC0_TAPA peripheral: PIC0 HIZCEN and REG2n0 registers used by TAPA (absolute addrs).
     Note: TAPA2 and TAPA3 do NOT have CTL1 (no A/D trigger select function). -->

<!-- ===== TAPA0 control registers (base0 = 0xFF815000) ===== -->
<peripheral>
  <name>TAPA0_CTL</name>
  <description>Timer Option Module 0 Control Registers (base0 region)</description>
  <baseAddress>0xFF815020</baseAddress>
  <addressBlock><offset>0x0</offset><size>0x5</size><usage>registers</usage></addressBlock>
  <registers>

    <register>
      <name>TAPA0CTL0</name>
      <description>TAPA0 Control Register 0 - Hi-Z edge/mode control</description>
      <addressOffset>0x0</addressOffset>
      <size>16</size>
      <access>read-write</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field><name>TAPA0DCM</name><description>Clearing condition specification bit</description><bitRange>[4:4]</bitRange></field>
        <field><name>TAPA0DCN</name><description>Hi-Z input edge selection bit N (falling)</description><bitRange>[3:3]</bitRange></field>
        <field><name>TAPA0DCP</name><description>Hi-Z input edge selection bit P (rising)</description><bitRange>[2:2]</bitRange></field>
      </fields>
    </register>

    <register>
      <name>TAPA0CTL1</name>
      <description>TAPA0 Control Register 1 - A/D converter trigger select (n=0,1 only)</description>
      <addressOffset>0x4</addressOffset>
      <size>8</size>
      <access>read-write</access>
      <resetValue>0x00</resetValue>
      <fields>
        <field><name>TAPA0ATS3</name><description>A/D converter trigger 1 select bit 1</description><bitRange>[3:3]</bitRange></field>
        <field><name>TAPA0ATS2</name><description>A/D converter trigger 1 select bit 0</description><bitRange>[2:2]</bitRange></field>
        <field><name>TAPA0ATS1</name><description>A/D converter trigger 0 select bit 1</description><bitRange>[1:1]</bitRange></field>
        <field><name>TAPA0ATS0</name><description>A/D converter trigger 0 select bit 0</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>

  </registers>
</peripheral>

<!-- ===== TAPA0 status/trigger registers (base1 = 0xFFFFD400) ===== -->
<peripheral>
  <name>TAPA0</name>
  <description>Timer Option Module 0 Status and Trigger Registers (base1 region)</description>
  <baseAddress>0xFFFFD400</baseAddress>
  <addressBlock><offset>0x0</offset><size>0x19</size><usage>registers</usage></addressBlock>
  <registers>

    <register>
      <name>TAPA0FLG</name>
      <description>TAPA0 Flag Register - Hi-Z output monitor and async control state</description>
      <addressOffset>0x0</addressOffset>
      <size>16</size>
      <access>read-only</access>
      <resetValue>0x0000</resetValue>
      <fields>
        <field><name>TAPA0HOF2</name><description>HZOUTm output monitor bit 2 (phase W)</description><bitRange>[10:10]</bitRange></field>
        <field><name>TAPA0HOF1</name><description>HZOUTm output monitor bit 1 (phase V)</description><bitRange>[9:9]</bitRange></field>
        <field><name>TAPA0HOF0</name><description>HZOUTm output monitor bit 0 (phase U)</description><bitRange>[8:8]</bitRange></field>
        <field><name>TAPA0ACE</name><description>Asynchronous Hi-Z control enable bit</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>

    <register>
      <name>TAPA0ACWE</name>
      <description>TAPA0 Asynchronous Control Write Enable Register</description>
      <addressOffset>0x4</addressOffset>
      <size>8</size>
      <access>read-write</access>
      <resetValue>0x00</resetValue>
      <fields>
        <field><name>TAPA0ACWE</name><description>Async control write enable bit (auto-cleared after ACTS/ACTT write)</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>

    <register>
      <name>TAPA0ACTS</name>
      <description>TAPA0 Asynchronous Control Start Trigger Register</description>
      <addressOffset>0x8</addressOffset>
      <size>8</size>
      <access>write-only</access>
      <resetValue>0x00</resetValue>
      <fields>
        <field><name>TAPA0ACTS</name><description>Async control start trigger bit (valid when ACWE=1)</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>

    <register>
      <name>TAPA0ACTT</name>
      <description>TAPA0 Asynchronous Control Stop Trigger Register</description>
      <addressOffset>0xC</addressOffset>
      <size>8</size>
      <access>write-only</access>
      <resetValue>0x00</resetValue>
      <fields>
        <field><name>TAPA0ACTT</name><description>Async control stop trigger bit (valid when ACWE=1)</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>

    <register>
      <name>TAPA0OPHS</name>
      <description>TAPA0 Hi-Z Start Trigger Register</description>
      <addressOffset>0x14</addressOffset>
      <size>8</size>
      <access>write-only</access>
      <resetValue>0x00</resetValue>
      <fields>
        <field><name>TAPA0OPHS0</name><description>Hi-Z control signal start trigger 0 bit</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>

    <register>
      <name>TAPA0OPHT</name>
      <description>TAPA0 Hi-Z Stop Trigger Register</description>
      <addressOffset>0x18</addressOffset>
      <size>8</size>
      <access>write-only</access>
      <resetValue>0x00</resetValue>
      <fields>
        <field><name>TAPA0OPHT0</name><description>Hi-Z control signal stop trigger 0 bit</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>

  </registers>
</peripheral>

