<!-- ===== PIC0 TAPA-related registers (PIC0 peripheral interconnect space) ===== -->
<!-- These registers live in PIC0 address space but are documented in Section 19.
     PIC0REG200 (n=0): 0xFF81C08C; PIC0REG210 (n=1): 0xFF81C09C
     PIC0HIZCEN0: 0xFF81C0B4; PIC0HIZCEN1: 0xFF81C0B8
     PIC0HIZCEN2: 0xFF81C0DC; PIC0HIZCEN3: 0xFF81C0E4
     Address block spans 0xFF81C08C to 0xFF81C0E4 (size 0x59). -->
<peripheral>
  <name>PIC0_TAPA</name>
  <description>PIC0 TAPA-related registers: Hi-Z output control and INT signal selection</description>
  <baseAddress>0xFF81C08C</baseAddress>
  <addressBlock><offset>0x0</offset><size>0x59</size><usage>registers</usage></addressBlock>
  <registers>

    <register>
      <name>PIC0REG200</name>
      <description>Timer I/O Control Register 200 - TAUA channel select for TAPA0 INT/up-down signals</description>
      <addressOffset>0x0</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <fields>
        <field><name>PIC0REG20025</name><description>TAUA channel select for TAPA0TSIM0/UDCM0 bit 1</description><bitRange>[25:25]</bitRange></field>
        <field><name>PIC0REG20024</name><description>TAUA channel select for TAPA0TSIM0/UDCM0 bit 0</description><bitRange>[24:24]</bitRange></field>
      </fields>
    </register>

    <register>
      <name>PIC0REG210</name>
      <description>Timer I/O Control Register 210 - TAUA channel select for TAPA1 INT/up-down signals</description>
      <addressOffset>0x10</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <fields>
        <field><name>PIC0REG21025</name><description>TAUA channel select for TAPA1TSIM0/UDCM0 bit 1</description><bitRange>[25:25]</bitRange></field>
        <field><name>PIC0REG21024</name><description>TAUA channel select for TAPA1TSIM0/UDCM0 bit 0</description><bitRange>[24:24]</bitRange></field>
      </fields>
    </register>

    <register>
      <name>PIC0HIZCEN0</name>
      <description>Hi-Z Output Control Register 0 - selects input signals for TAPA0 Hi-Z control</description>
      <addressOffset>0x28</addressOffset>
      <size>8</size>
      <access>read-write</access>
      <resetValue>0x00</resetValue>
      <fields>
        <field><name>PIC0HIZCEN06</name><description>Enable Hi-Z control by INTADCA0TERR interrupt signal</description><bitRange>[6:6]</bitRange></field>
        <field><name>PIC0HIZCEN05</name><description>Enable Hi-Z control by ERROROUT signal</description><bitRange>[5:5]</bitRange></field>
        <field><name>PIC0HIZCEN00</name><description>Enable Hi-Z control by ESO0 pin input</description><bitRange>[0:0]</bitRange></field>
      </fields>
    </register>

    <register>
      <name>PIC0HIZCEN1</name>
