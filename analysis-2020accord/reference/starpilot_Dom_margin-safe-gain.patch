 selfdrive/controls/lib/latcontrol_torque.py        |  6 +++--
 selfdrive/controls/lib/latcontrol_vehicle_tunes.py | 18 ++++++++++++++
 starpilot/common/starpilot_variables.py            | 10 +++++++-
 3 files changed, 31 insertions(+), 3 deletions(-)

diff --git a/starpilot/common/starpilot_variables.py b/starpilot/common/starpilot_variables.py
--- a/starpilot/common/starpilot_variables.py
+++ b/starpilot/common/starpilot_variables.py
@@ -456,7 +456,15 @@ LAT_ACCEL_FACTOR_MAX_MULT = 10.0
 # SteerKP toggle ceiling as a multiple of the platform Kp. The old 1.5x clamp (0.9 on the Accord) sat
 # below what the identified rate-servo plant tolerates; the floor stays low but non-zero.
 STEER_KP_MIN = 0.05
-STEER_KP_MAX_MULT = 5.0
+# 2026-09-20: 5.0 -> 10.0 (Accord ceiling 3.00 -> 6.00 at the platform Kp of 0.6).  NOT so SteerKP alone can go
+# higher -- measured on the identified loop, every setting above 2.0 at the stock notch Q sits at or below the
+# 2-6 Hz vector margin of route 71, the only route that has ever limit-cycled.  It is so the gain can be raised
+# TOGETHER WITH a wide error notch (Q 0.20-0.30), which is the pairing that holds the 3.4-4.9 Hz mode down while
+# the 0.15-0.60 Hz gain -- where 98% of the tracking gap to the V282 reference lives -- goes up.  At matched
+# vector margin that pairing measures 23% (KP 5.0 / Q 0.20) and 33% (KP 6.0 / Q 0.20) of the gap, at command
+# shake at or below as-flown.  Raising KP alone is what this ceiling used to prevent, and still should;
+# get_honda_accord_error_notch_q is the other half of the change.  STEER_KP_MIN untouched.
+STEER_KP_MAX_MULT = 10.0

 class StarPilotVariables:
   def __init__(self):
diff --git a/selfdrive/controls/lib/latcontrol_vehicle_tunes.py b/selfdrive/controls/lib/latcontrol_vehicle_tunes.py
--- a/selfdrive/controls/lib/latcontrol_vehicle_tunes.py
+++ b/selfdrive/controls/lib/latcontrol_vehicle_tunes.py
@@ -393,6 +393,24 @@ HONDA_ACCORD_KI_SCHEDULE_V_BP = [8.0, 18.0]        # m/s
+# AccordErrorNotchQ, speed-scheduled (2026-09-20).  The notch CENTRE is already a function of speed
+# (get_honda_accord_mode_hz: 0.82 Hz at 2 m/s, 1.28 at 8, 2.05 at 23), so one scalar Q is a different filter at
+# every speed.  A Q wide enough to protect the 3.4-4.9 Hz mode at motorway speed sits on top of the demand at
+# low speed: measured |N| and phase at 0.3 Hz are 0.920 @ -23 deg (Q 1.0) but 0.576 @ -55 deg (Q 0.30) and
+# 0.426 @ -65 deg (Q 0.20) at 2 m/s.  That is the regime the operator reports as ratchety, and it is OUTSIDE
+# the goal metric (every scored window is >= 15.75 m/s), so a scalar Q buys margin at speed by silently
+# spending feel at low speed.  Scheduling it costs nothing measurable on the metric BY CONSTRUCTION and makes
+# the wide Q survivable.  Below 8 m/s the delivered Q is pinned to the 1.0 that has already driven.
+HONDA_ACCORD_NOTCH_Q_V_BP = [8.0, 15.0]   # m/s.  8.0 is already a fork breakpoint (KI_SCHEDULE_V_BP[0]);
+                                          # 15.0 is the goal metric's own floor, so above it the toggle value
+                                          # is delivered exactly as it was scored.
+HONDA_ACCORD_NOTCH_Q_LOW = 1.0            # the Q flown on rev 6.4: nothing below 8 m/s changes.
+
+
+def get_honda_accord_error_notch_q(v_ego: float, q: float) -> float:
+  """AccordErrorNotchQ narrowed at low speed.  q <= 0 (notch bypassed) passes straight through, and q >= 1.0
+  is speed-flat, so the shipped default of 1.0 reproduces the previous behaviour at every speed exactly."""
+  if q <= 0.0:
+    return q
+  return float(np.interp(v_ego, HONDA_ACCORD_NOTCH_Q_V_BP, [max(q, HONDA_ACCORD_NOTCH_Q_LOW), q]))
+
 # Disturbance observer (AccordDobHz, rev 5, 2026-09-15).  A P loop through the ~60 ms round trip has a static stiffness of
